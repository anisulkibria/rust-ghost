# Rust
/target/
debug/
release/
**/*.rs.bk

# runtime content (regenerated on first boot — never commit)
content/cache/
content/data/
content/logs/
content/images/
content/media/
content/files/
content/themes/dripthemes
# whole-site backups (Settings → Backups): they hold every password hash and API key
content/backups/
.DS_Store

# local config (contains your local db path / secrets)
config.local*.json
.env

# editor
.claude/
.idea/
.vscode/
*.swp
