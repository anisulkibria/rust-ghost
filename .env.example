# Per-machine settings for ./run.sh. Copy to .env (gitignored) and edit.
# A variable already set in the shell wins over this file.
# Every GHOST_* variable is read by the server itself as a config override:
# GHOST_<SECTION>__<KEY>, so the checkout can live in any directory and
# nothing in the tree has to name this machine.

# Port the site is served on (config server.port). run.sh checks the same one.
# GHOST_SERVER__PORT=1971

# Public URL (config url). Keep it in step with the port.
# GHOST_URL=http://localhost:1971

# Where content/ lives: themes, data, images, files. Relative to this
# directory; unset means ./content. Point it elsewhere to keep site data out
# of the checkout, or to share one content directory between checkouts.
# GHOST_PATHS__CONTENT_PATH=content

# Which config.<env>.json is read (development unless set).
# GHOST_ENV=development

# Optional, tests only. A reference Node Ghost installation (the directory
# holding current/ and content/themes) for the gscan parity tests in
# crates/ghost-render; they skip when this is unset. GSCAN_PATH names a gscan
# package directly when it is not inside that install.
# GHOST_REFERENCE_DIR=/path/to/ghost-install
# GSCAN_PATH=/path/to/node_modules/gscan

# Optional, tests only: run the database tests against MySQL as well.
# GHOST_TEST_MYSQL_URL=mysql://user:password@127.0.0.1:3306/ghost_test
