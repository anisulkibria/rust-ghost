{{!< default}}

<main class="site-main" id="main">
    {{#author}}
        <header class="list-header author-header wrap">
            {{#if profile_image}}
                <img class="author-portrait" src="{{img_url profile_image size="s"}}" alt="" width="112" height="112">
            {{/if}}
            <div>
                <h1 class="list-title">{{name}}</h1>
                {{#if bio}}<p class="list-dek">{{bio}}</p>{{/if}}
                <ul class="author-links" role="list">
                    <li>{{plural ../pagination.total empty=(t "No posts yet") singular=(t "1 post") plural=(t "% posts")}}</li>
                    {{#if location}}<li>{{location}}</li>{{/if}}
                    {{#if website}}<li><a href="{{website}}" target="_blank" rel="noopener">{{readable_url website}}</a></li>{{/if}}
                    {{#if instagram}}<li><a href="{{social_url type="instagram"}}" target="_blank" rel="noopener">Instagram</a></li>{{/if}}
                    {{#if twitter}}<li><a href="{{social_url type="x"}}" target="_blank" rel="noopener">X</a></li>{{/if}}
                    {{#if bluesky}}<li><a href="{{social_url type="bluesky"}}" target="_blank" rel="noopener">Bluesky</a></li>{{/if}}
                </ul>
            </div>
        </header>
    {{/author}}

    <div class="grid wrap">
        {{#foreach posts}}{{> "card"}}{{/foreach}}
    </div>

    {{pagination}}
</main>
