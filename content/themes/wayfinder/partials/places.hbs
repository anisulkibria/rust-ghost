{{!-- A photo tile for each place tag named in the theme's Places setting. --}}
{{!-- This engine cannot filter tags by a list of slugs, so every public tag is fetched and the Places setting sorts them: a tag whose slug appears in it is a place, anything else is a category. --}}
{{#if @custom.places}}
    {{#get "tags" limit="60" include="count.posts" order="count.posts desc" filter="visibility:public" as |all|}}
        <section class="band" aria-labelledby="places-heading">
            <header class="section-head wrap">
                <h2 class="section-title" id="places-heading">{{t "Where to go"}}</h2>
            </header>
            <ul class="place-grid wrap" role="list">
                {{#foreach all}}
                    {{#match @custom.places "~" slug}}
                        <li>
                            <a class="place" href="{{url}}">
                                {{#if feature_image}}<img src="{{img_url feature_image size="m"}}" alt="" loading="lazy">{{/if}}
                                <span class="place-label">
                                    <span class="place-name">{{name}}</span>
                                    <span class="place-count">{{plural count.posts empty=(t "No places yet") singular=(t "1 place") plural=(t "% places")}}</span>
                                </span>
                            </a>
                        </li>
                    {{/match}}
                {{/foreach}}
            </ul>
        </section>
    {{/get}}
{{/if}}
