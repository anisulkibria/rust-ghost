{{!-- A directory listing's price range: price_signs ($$) in full, the unused signs faint. --}}
{{#if price_signs}}<p class="price" title="{{price_label}}"><span class="visually-hidden">{{t "Price"}}: {{price_label}}</span><span aria-hidden="true"><b>{{price_signs}}</b>{{price_unused}}</span></p>{{/if}}
