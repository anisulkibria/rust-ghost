{{!< default}}

<main id="main" class="error-page">
    <div class="error-inner wrap">
        <p class="error-code">404</p>
        <div class="error-text">
            <h1 class="error-title">{{t "There’s no page at this address"}}</h1>
            <p class="error-description">{{t "The link may be old, or the episode may have moved. Search the episodes, or start from the newest one."}}</p>
            <p class="error-actions">
                <button class="button" type="button" data-ghost-search>{{t "Search episodes"}}</button>
                <a class="text-link" href="{{@site.url}}">{{t "Go to the homepage"}}</a>
            </p>
        </div>
    </div>

    {{#get "posts" limit="4" as |recent|}}
        {{#if recent}}
            <section class="episodes-section" aria-labelledby="recent-title">
                <div class="wrap">
                    <header class="section-head">
                        <h2 class="section-title" id="recent-title">{{t "Newest episodes"}}</h2>
                    </header>
                    <ol class="episodes is-compact" role="list">
                        {{#foreach recent}}{{> "episode-row"}}{{/foreach}}
                    </ol>
                </div>
            </section>
        {{/if}}
    {{/get}}
</main>
