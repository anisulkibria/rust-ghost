{{!-- The stage: one episode, set on the show's accent colour, with the
     player. The homepage passes the newest post; an episode page passes
     itself. `heading` is "h1" on an episode page and "h2" on the homepage. --}}
<section class="stage{{#if feature_image}} has-art{{/if}}" data-stage aria-labelledby="stage-title">
    <div class="stage-inner wrap">
        {{#if @custom.number_episodes}}
            <p class="stage-number"><span class="visually-hidden">{{t "Episode"}} </span>{{> "episode-number"}}</p>
        {{/if}}

        <div class="stage-main">
            <p class="stage-when">
                {{#is "home"}}<span class="stage-newest">{{t "Newest episode"}}</span>{{/is}}
                <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="D MMMM YYYY"}}</time>
            </p>

            {{#match heading "h1"}}
                <h1 class="stage-title" id="stage-title">{{title}}</h1>
            {{else}}
                <h2 class="stage-title" id="stage-title"><a href="{{url}}">{{title}}</a></h2>
            {{/match}}

            {{#if custom_excerpt}}<p class="stage-subtitle">{{custom_excerpt}}</p>{{/if}}
            {{#is "post"}}
                {{#if authors}}<p class="stage-hosts">{{t "Hosted by"}} {{authors}}</p>{{/if}}
            {{/is}}
        </div>

        {{#if feature_image}}
            <figure class="stage-art">
                <img
                    srcset="{{img_url feature_image size="s"}} 400w, {{img_url feature_image size="m"}} 720w"
                    sizes="(max-width: 820px) 104px, 260px"
                    src="{{img_url feature_image size="m"}}"
                    alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}">
            </figure>
        {{/if}}

        <div class="stage-listen">
            {{#if access}}
                {{> "player"}}
            {{else}}
                {{> "stage-locked"}}
            {{/if}}
        </div>
    </div>
</section>
