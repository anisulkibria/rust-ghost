{{#if @site.members_enabled}}
    {{#unless @member}}
        {{#unless @site.members_invite_only}}
            <section class="subscribe-band" aria-labelledby="subscribe-title">
                <div class="subscribe-inner wrap">
                    <div class="subscribe-copy">
                        <h2 class="subscribe-title" id="subscribe-title">{{#if @custom.signup_heading}}{{@custom.signup_heading}}{{else}}{{t "Get new episodes by email"}}{{/if}}</h2>
                        <p class="subscribe-text">{{#if @custom.signup_text}}{{@custom.signup_text}}{{else}}{{t "One email when an episode comes out, with the show notes. Unsubscribe anytime."}}{{/if}}</p>
                    </div>
                    {{> "subscribe-form" field_id="band-email"}}
                </div>
            </section>
        {{/unless}}
    {{/unless}}
{{/if}}
