{{!-- The full player. The audio itself comes from the first audio card in
     the episode: on an episode page the script reads it from the show notes;
     anywhere else it reads the start of the show notes from the template. --}}
<div class="player" data-player
    data-id="{{id}}"
    data-url="{{url}}"
    data-title="{{title}}"
    data-art="{{#if feature_image}}{{img_url feature_image size="s"}}{{/if}}">
    {{^is "post"}}<template data-source>{{content words="600"}}</template>{{/is}}

    <button class="play" type="button" data-play disabled>
        <span class="play-glyph">{{> "icons/play"}}</span>
        <span class="pause-glyph">{{> "icons/pause"}}</span>
        <span class="visually-hidden" data-play-label>{{t "Play"}}</span>
    </button>

    <div class="player-deck">
        <div class="tape" data-tape>
            <div class="tape-track" data-track><span class="tape-splice"><span class="tape-fill"></span></span></div>
            <input class="tape-seek" type="range" min="0" max="0" step="1" value="0" aria-label="{{t "Position in episode"}}" data-scrub disabled>
        </div>

        <div class="player-readout">
            <p class="player-time"><span data-elapsed>0:00</span> <span class="player-slash">/</span> <span data-duration>&ndash;:&ndash;&ndash;</span></p>
            <p class="player-chapter" data-chapter aria-live="polite"></p>
        </div>

        <div class="player-controls">
            <button class="chip" type="button" data-skip="-15" aria-label="{{t "Back 15 seconds"}}">{{> "icons/back"}}<span aria-hidden="true">15</span></button>
            <button class="chip chip-rate" type="button" data-rate aria-label="{{t "Playback speed"}}"><span data-rate-label>1×</span></button>
            <button class="chip" type="button" data-skip="30" aria-label="{{t "Forward 30 seconds"}}"><span aria-hidden="true">30</span>{{> "icons/forward"}}</button>
            <span class="player-links">
                <a class="player-link" href="{{url}}" download data-download hidden>{{t "Download"}}</a>
                <button class="player-link" type="button" data-share data-share-url="{{url}}"><span data-share-label>{{t "Copy link"}}</span></button>
            </span>
        </div>
    </div>

    <p class="player-missing">
        {{#is "post"}}
            {{t "Listen with the player in the show notes below."}}
        {{else}}
            <a href="{{url}}">{{t "Read the show notes"}}</a>
        {{/is}}
    </p>
</div>
