{{#match pagination.pages ">" 1}}
<nav class="ea-pager" aria-label="Pages">
{{#if pagination.prev}}<a class="ea-pill" href="{{page_url pagination.prev}}">← Newer</a>{{else}}<span></span>{{/if}}
<span>Page {{pagination.page}} of {{pagination.pages}}</span>
{{#if pagination.next}}<a class="ea-pill" href="{{page_url pagination.next}}">Older →</a>{{else}}<span></span>{{/if}}
</nav>
{{/match}}
