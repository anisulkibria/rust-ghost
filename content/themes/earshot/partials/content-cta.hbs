{{{html}}}
<aside class="paywall">
    <h2 class="paywall-title">
        {{#has visibility="paid"}}{{t "The full episode is for paid subscribers"}}{{/has}}
        {{#has visibility="members"}}{{t "The full episode is for subscribers"}}{{/has}}
        {{#has visibility="tiers"}}{{t "The full episode is for selected tiers"}}{{/has}}
    </h2>
    {{#if @member}}
        <p>{{t "Your plan doesn’t include this episode. Upgrade to listen and read the full show notes."}}</p>
        <p class="paywall-actions"><a class="button" href="#/portal/account/plans" data-portal="account/plans">{{t "Upgrade your plan"}}</a></p>
    {{else}}
        {{#has visibility="members"}}
            <p>{{t "Sign up free to listen, and get new episodes by email."}}</p>
            <p class="paywall-actions"><a class="button" href="#/portal/signup" data-portal="signup">{{t "Sign up to listen"}}</a></p>
        {{else}}
            <p>{{t "Subscribe to listen, and get every new episode by email."}}</p>
            <p class="paywall-actions"><a class="button" href="#/portal/signup" data-portal="signup">{{t "Subscribe to listen"}}</a></p>
        {{/has}}
        <p class="paywall-signin">{{t "Already subscribed?"}} <a href="#/portal/signin" data-portal="signin">{{t "Sign in"}}</a></p>
    {{/if}}
</aside>
