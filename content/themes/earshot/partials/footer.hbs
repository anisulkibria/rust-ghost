<footer class="site-footer">
    <div class="site-footer-inner wrap">
        <p class="footer-brand"><a href="{{@site.url}}">{{@site.title}}</a></p>
        {{#if @site.secondary_navigation}}
            <nav class="footer-nav" aria-label="{{t "Footer"}}">{{navigation type="secondary"}}</nav>
        {{/if}}
        <div class="footer-social">{{social_accounts}}</div>
        <p class="footer-meta">
            <span>&copy; {{date format="YYYY"}} {{@site.title}}</span>
            <a href="{{@site.url}}/rss/">{{t "Site RSS"}}</a>
            <span>{{t "Published with Vuuut"}}</span>
        </p>
    </div>
</footer>
