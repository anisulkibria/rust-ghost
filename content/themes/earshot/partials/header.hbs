<header class="ea-head" data-ea-head>
    <div class="ea-wrap ea-head-in">
        <a class="ea-logo" href="{{@site.url}}">
            {{#if @site.logo}}<img src="{{@site.logo}}" alt="{{@site.title}}">
            {{else}}<span class="ea-logo-mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span><span>{{@site.title}}</span>{{/if}}
        </a>
        <nav class="ea-nav" aria-label="Main">
            {{#if podcast}}<a class="ea-nav-listen" href="{{podcast.url}}">Listen</a>{{/if}}
            {{navigation}}
        </nav>
        <div class="ea-head-end">
            <button class="ea-icon-btn" type="button" data-ghost-search aria-label="Search">{{> "icon" name="search" size="19"}}</button>
            {{#if @site.members_enabled}}
                {{#if @member}}<a class="ea-link ea-hide-s" href="#/portal/account">Account</a>
                {{else}}<a class="ea-link ea-hide-s" href="#/portal/signin">Sign in</a><a class="ea-btn ea-btn-sm ea-hide-s" href="#/portal/signup">Subscribe</a>{{/if}}
            {{/if}}
            <button class="ea-icon-btn ea-burger" type="button" aria-label="Menu" aria-expanded="false" aria-controls="ea-menu" data-ea-burger>{{> "icon" name="menu" size="22"}}</button>
        </div>
    </div>
</header>
<dialog class="ea-drawer" id="ea-menu" aria-label="Site menu" data-ea-drawer>
    <button class="ea-icon-btn ea-drawer-close" type="button" aria-label="Close" data-ea-drawer-close>{{> "icon" name="close" size="24"}}</button>
    <nav aria-label="Main">
        {{#if podcast}}<a href="{{podcast.url}}">Listen</a>{{/if}}
        {{#foreach @site.navigation}}<a href="{{url absolute="true"}}">{{label}}</a>{{/foreach}}
    </nav>
    {{#if @site.members_enabled}}
        <div class="ea-drawer-actions">
            {{#if @member}}<a class="ea-btn" href="#/portal/account">Account</a>
            {{else}}<a class="ea-btn" href="#/portal/signup">Subscribe</a><a class="ea-link" href="#/portal/signin">Sign in</a>{{/if}}
        </div>
    {{/if}}
</dialog>
