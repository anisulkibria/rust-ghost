<div class="stage-locked">
    <p class="stage-locked-text">
        {{> "icons/lock"}}
        <span>
            {{#has visibility="paid"}}{{t "This episode is for paid subscribers."}}{{/has}}
            {{#has visibility="members"}}{{t "This episode is for subscribers. Signing up is free."}}{{/has}}
            {{#has visibility="tiers"}}{{t "This episode is for selected tiers."}}{{/has}}
        </span>
    </p>
    <p class="stage-locked-actions">
        {{#if @member}}
            <a class="button button-inverse" href="#/portal/account/plans" data-portal="account/plans">{{t "Upgrade to listen"}}</a>
        {{else}}
            {{#has visibility="members"}}
                <a class="button button-inverse" href="#/portal/signup" data-portal="signup">{{t "Sign up to listen"}}</a>
            {{else}}
                <a class="button button-inverse" href="#/portal/signup" data-portal="signup">{{t "Subscribe to listen"}}</a>
            {{/has}}
            <a class="text-link" href="#/portal/signin" data-portal="signin">{{t "Sign in"}}</a>
        {{/if}}
    </p>
</div>
