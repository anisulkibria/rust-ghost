<article class="ea-row">
<a class="ea-row-art" href="{{url}}" tabindex="-1" aria-hidden="true">{{> "art" class="ea-row-img"}}</a>
<div class="ea-row-body">
{{> "meta"}}
<h3 class="ea-row-title"><a href="{{url}}">{{title}}</a></h3>
{{#if summary}}<p class="ea-row-sum">{{summary}}</p>{{/if}}
</div>
<div class="ea-row-end">{{> "play"}}</div>
</article>
