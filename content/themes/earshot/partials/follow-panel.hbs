{{!-- Following a show means two things: a podcast app, and (when memberships
     are on) email. Both live here, behind the one "Follow" button, which
     hides itself when neither is set up. --}}
<div class="follow-panel" id="follow-panel" popover data-follow-panel aria-labelledby="follow-title">
    <div class="follow-head">
        <h2 class="follow-title" id="follow-title">{{t "Follow {title}" title=@site.title}}</h2>
        <button class="icon-button" type="button" popovertarget="follow-panel" popovertargetaction="hide" aria-label="{{t "Close"}}" data-follow-close>{{> "icons/close"}}</button>
    </div>

    <div class="follow-apps">
        <p class="follow-lede">{{t "Get every new episode in the app you already use."}}</p>
        {{> "listen-links" stacked=true}}
    </div>

    {{#if @site.members_enabled}}
        {{#unless @member}}
            {{#unless @site.members_invite_only}}
                <div class="follow-email">
                    <h3 class="follow-subtitle">
                        <span class="when-apps">{{t "Or get them by email"}}</span>
                        <span class="when-no-apps">{{t "Get new episodes by email"}}</span>
                    </h3>
                    {{> "subscribe-form" field_id="follow-email"}}
                </div>
            {{/unless}}
        {{/unless}}
    {{/if}}
</div>
