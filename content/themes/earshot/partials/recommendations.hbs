{{#if recommendations}}
<ul class="recs" role="list">
    {{#foreach recommendations}}
        <li class="rec">
            <a class="rec-link" href="{{url}}" data-recommendation="{{id}}" target="_blank" rel="noopener">
                {{#if favicon}}<img class="rec-icon" src="{{favicon}}" alt="" width="20" height="20" loading="lazy">{{/if}}
                <span class="rec-title">{{title}}</span>
            </a>
            {{#if description}}<p class="rec-description">{{description}}</p>{{/if}}
            <p class="rec-url">{{readable_url url}}</p>
        </li>
    {{/foreach}}
</ul>
{{/if}}
