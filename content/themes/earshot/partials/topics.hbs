{{#get "tags" limit="8" filter="visibility:public" include="count.posts" order="count.posts desc" as |topics|}}
    {{#if topics}}
        <nav class="topics" aria-label="{{t "Topics"}}">
            <ul role="list">
                {{#foreach topics}}
                    <li><a href="{{url}}">{{name}}</a></li>
                {{/foreach}}
            </ul>
        </nav>
    {{/if}}
{{/get}}
