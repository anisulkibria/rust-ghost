<ul class="listen{{#if stacked}} is-stacked{{/if}}" role="list">
    {{#if @custom.apple_podcasts_url}}
        <li><a class="listen-link" href="{{@custom.apple_podcasts_url}}" rel="noopener">{{> "icons/apple-podcasts"}}<span><span class="visually-hidden">{{t "Listen on"}} </span>Apple Podcasts</span></a></li>
    {{/if}}
    {{#if @custom.spotify_url}}
        <li><a class="listen-link" href="{{@custom.spotify_url}}" rel="noopener">{{> "icons/spotify"}}<span><span class="visually-hidden">{{t "Listen on"}} </span>Spotify</span></a></li>
    {{/if}}
    {{#if @custom.youtube_url}}
        <li><a class="listen-link" href="{{@custom.youtube_url}}" rel="noopener">{{> "icons/youtube"}}<span><span class="visually-hidden">{{t "Watch on"}} </span>YouTube</span></a></li>
    {{/if}}
    {{#if @custom.podcast_rss_url}}
        <li>
            <button class="listen-link" type="button" data-copy="{{@custom.podcast_rss_url}}">
                {{> "icons/rss"}}<span data-copy-label>{{t "Copy RSS feed"}}</span><span class="visually-hidden">{{t ", to paste into any podcast app"}}</span>
            </button>
        </li>
    {{/if}}
</ul>
