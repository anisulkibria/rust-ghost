{{!< default}}
<main id="main" class="ea-main">
{{#author}}<header class="ea-wrap ea-page-head ea-author">{{#if profile_image}}<img src="{{img_url profile_image size="s"}}" alt="">{{/if}}<div><p class="ea-eyebrow">Author</p><h1 class="ea-h1">{{name}}</h1>{{#if bio}}<p class="ea-lede">{{bio}}</p>{{/if}}</div></header>{{/author}}
<section class="ea-wrap ea-block ea-block-top"><div class="ea-posts">{{#foreach posts}}{{> "post-card"}}{{/foreach}}</div>{{> "pager"}}</section>
</main>
