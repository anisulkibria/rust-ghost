{{!< default}}

{{#post}}
<main id="main" class="episode-page">
    {{> "stage" heading="h1"}}

    <div class="notes-layout wrap">
        <article class="notes {{post_class}}">
            <h2 class="visually-hidden">{{t "Show notes"}}</h2>
            <div class="content" data-content>
                {{content}}
            </div>

            {{#if tags}}
                <p class="notes-topics"><span>{{t "Topics"}}</span> {{tags separator=""}}</p>
            {{/if}}
        </article>

        {{#if @custom.show_chapters}}
            <aside class="rail" data-rail hidden aria-labelledby="rail-title">
                <div class="rail-inner">
                    <h2 class="rail-title" id="rail-title">{{t "In this episode"}}</h2>
                    <ol class="chapters" role="list" data-chapter-list></ol>
                </div>
            </aside>
        {{/if}}
    </div>

    <div class="after-notes wrap">
        {{#if @custom.show_host_card}}
            {{#foreach authors}}{{> "host-card"}}{{/foreach}}
        {{/if}}

        <nav class="episode-nav" aria-label="{{t "Previous and next episodes"}}">
            {{#prev_post}}
                <a class="episode-nav-link is-prev" href="{{url}}">
                    <span class="episode-nav-label">{{t "Previous episode"}}</span>
                    <span class="episode-nav-title">{{#if @custom.number_episodes}}<span class="episode-nav-number">{{> "episode-number"}}</span> {{/if}}{{title}}</span>
                </a>
            {{/prev_post}}
            {{#next_post}}
                <a class="episode-nav-link is-next" href="{{url}}">
                    <span class="episode-nav-label">{{t "Next episode"}}</span>
                    <span class="episode-nav-title">{{#if @custom.number_episodes}}<span class="episode-nav-number">{{> "episode-number"}}</span> {{/if}}{{title}}</span>
                </a>
            {{/next_post}}
        </nav>

        {{#if comments}}
            <section class="comments" id="comments" aria-labelledby="comments-title">
                <h2 class="section-title" id="comments-title">{{t "Comments"}}</h2>
                {{!-- Auto reads the page colours, so it follows the light/dark switch. --}}
                {{comments title="" count=false}}
            </section>
        {{/if}}

        {{#if @custom.show_related_episodes}}
            {{#if primary_tag}}
                {{#get "posts" filter="tags:{{primary_tag.slug}}+id:-{{id}}" limit="3" as |related|}}
                    {{#if related}}
                        <section class="related" aria-labelledby="related-title">
                            <h2 class="section-title" id="related-title">{{t "More on this topic"}}</h2>
                            <ol class="episodes is-compact" role="list">
                                {{#foreach related}}{{> "episode-row"}}{{/foreach}}
                            </ol>
                        </section>
                    {{/if}}
                {{/get}}
            {{/if}}
        {{/if}}
    </div>
</main>
{{/post}}
