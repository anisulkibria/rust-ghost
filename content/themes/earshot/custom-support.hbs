{{!< default}}
{{!-- Template: Support the show. Your membership tiers, with prices and a signup button for each. --}}

{{#post}}
<main id="main" class="page-main">
    <header class="page-head">
        <div class="wrap">
            <h1 class="page-title">{{title}}</h1>
            {{#if custom_excerpt}}<p class="page-lede">{{custom_excerpt}}</p>{{/if}}
        </div>
    </header>

    {{#if @site.members_enabled}}
        {{#get "tiers" include="monthly_price,yearly_price,benefits" limit="20" as |tiers|}}
            {{#if tiers}}
                <section class="tiers wrap" aria-label="{{t "Membership options"}}">
                    {{!-- Paid tiers only appear once the site can take payments. --}}
                    {{#if @site.paid_members_enabled}}
                        <fieldset class="interval">
                            <legend class="visually-hidden">{{t "Billing period"}}</legend>
                            <input type="radio" name="interval" id="interval-monthly" value="monthly" checked>
                            <label for="interval-monthly">{{t "Monthly"}}</label>
                            <input type="radio" name="interval" id="interval-yearly" value="yearly">
                            <label for="interval-yearly">{{t "Yearly"}}</label>
                        </fieldset>
                    {{/if}}

                    <ul class="tier-list" role="list">
                        {{#foreach tiers}}
                            {{#match type "free"}}
                                {{> "tier"}}
                            {{else}}
                                {{#if @site.paid_members_enabled}}{{> "tier"}}{{/if}}
                            {{/match}}
                        {{/foreach}}
                    </ul>
                </section>
            {{/if}}
        {{/get}}
    {{/if}}

    {{#if html}}
        <div class="page-body wrap">
            <div class="content" data-content>{{content}}</div>
        </div>
    {{/if}}
</main>
{{/post}}
