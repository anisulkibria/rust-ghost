{{#if @site.members_enabled}}
    {{#unless @member}}
        {{#unless @site.members_invite_only}}
            {{> "signup"}}
        {{/unless}}
    {{/unless}}
{{/if}}

<footer class="site-footer">
    <div class="site-footer-inner wrap">
        <div class="site-footer-about">
            <a class="site-footer-title" href="{{@site.url}}">{{@site.title}}</a>
            {{#if @site.description}}<p>{{@site.description}}</p>{{/if}}
            <div class="site-footer-social">{{social_accounts}}</div>
        </div>

        {{#get "tags" limit="10" include="count.posts" order="count.posts desc" filter="visibility:public" as |topics|}}
            {{#if topics}}
                <nav class="site-footer-col" aria-labelledby="footer-topics">
                    <h2 class="site-footer-heading" id="footer-topics">{{t "Topics"}}</h2>
                    <ul class="nav">
                        {{#foreach topics}}<li><a href="{{url}}">{{name}}</a></li>{{/foreach}}
                    </ul>
                </nav>
            {{/if}}
        {{/get}}

        <nav class="site-footer-col" aria-labelledby="footer-more">
            <h2 class="site-footer-heading" id="footer-more">{{@site.title}}</h2>
            {{#if @site.secondary_navigation}}
                {{navigation type="secondary"}}
            {{/if}}
            <ul class="nav">
                {{#if @site.recommendations_enabled}}
                    <li><a href="#/portal/recommendations" data-portal="recommendations">{{t "Recommendations"}}</a></li>
                {{/if}}
                <li><a href="{{@site.url}}/rss/">{{t "RSS feed"}}</a></li>
            </ul>
        </nav>
    </div>

    <div class="site-footer-base wrap">
        <p>&copy; {{date format="YYYY"}} {{@site.title}}</p>
        <p><a href="https://vuuut.com" target="_blank" rel="noopener">{{t "Published with Vuuut"}}</a></p>
    </div>
</footer>
