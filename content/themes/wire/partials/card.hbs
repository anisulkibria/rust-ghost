{{!--
    A story. size: "lead" (homepage opener), "row" (thumbnail beside text),
    "line" (headline only) or nothing (grid card).
--}}
<article class="card{{#if size}} card-{{size}}{{/if}} {{post_class}}">
    {{#match size "!=" "line"}}
        {{#if feature_image}}
            <a class="card-image" href="{{url}}" tabindex="-1" aria-hidden="true">
                <img
                    srcset="{{img_url feature_image size="s"}} 400w, {{img_url feature_image size="m"}} 760w, {{img_url feature_image size="l"}} 1200w"
                    sizes="{{#match size "lead"}}(max-width: 1000px) 100vw, 820px{{else match size "row"}}160px{{else}}(max-width: 640px) 100vw, 400px{{/match}}"
                    src="{{img_url feature_image size="m"}}"
                    alt=""
                    {{#match size "!=" "lead"}}loading="lazy"{{/match}}>
            </a>
        {{/if}}
    {{/match}}

    <div class="card-text">
        <p class="card-kicker">
            {{#if primary_tag}}<a class="card-topic" href="{{primary_tag.url}}">{{primary_tag.name}}</a>{{/if}}
            {{> "when"}}
            {{#match visibility "!=" "public"}}<span class="card-access" title="{{#match visibility "paid"}}{{t "For paid subscribers"}}{{else}}{{t "For members"}}{{/match}}">{{> "icons/lock"}}<span class="visually-hidden">{{#match visibility "paid"}}{{t "For paid subscribers"}}{{else}}{{t "For members"}}{{/match}}</span></span>{{/match}}
        </p>
        {{#match size "lead"}}
            <h2 class="card-title"><a href="{{url}}">{{title}}</a></h2>
        {{else}}
            <h3 class="card-title"><a href="{{url}}">{{title}}</a></h3>
        {{/match}}
        {{#match size "lead"}}
            {{#if excerpt}}<p class="card-excerpt">{{excerpt words="40"}}</p>{{/if}}
            {{#if authors}}
                <p class="card-byline">
                    <span class="faces" aria-hidden="true">{{#foreach authors limit="3"}}{{#if profile_image}}<img src="{{img_url profile_image size="xs"}}" alt="" width="28" height="28">{{/if}}{{/foreach}}</span>
                    {{t "By"}} {{authors separator=" & " autolink="false"}}
                </p>
            {{/if}}
        {{/match}}
        {{#unless size}}
            {{#if authors}}<p class="card-byline">{{t "By"}} {{authors separator=" & " autolink="false"}}</p>{{/if}}
        {{/unless}}
    </div>
</article>
