{{!< default}}

<main class="site-main" id="main">
    {{#is "paged"}}
        <header class="desk-header wrap">
            <h1 class="desk-title">{{t "All stories"}}</h1>
            <p class="desk-meta">{{t "Page {page} of {pages}" page=pagination.page pages=pagination.pages}}</p>
        </header>
        <div class="grid wrap">
            {{#foreach posts}}{{> "card"}}{{/foreach}}
        </div>
        {{pagination}}
    {{else}}
        <h1 class="visually-hidden">{{@site.title}}</h1>

        {{#if posts}}
            <section class="front wrap" aria-labelledby="front-heading">
                <div class="front-lead">
                    <h2 class="front-heading" id="front-heading">{{t "Top story"}}</h2>
                    {{#foreach posts limit="1"}}{{> "card" size="lead" front=true}}{{/foreach}}
                </div>

                {{#match posts.length ">" 1}}
                    <aside class="timeline" aria-labelledby="timeline-heading">
                        <h2 class="timeline-heading" id="timeline-heading"><span class="live-dot" aria-hidden="true"></span>{{#if @custom.timeline_title}}{{@custom.timeline_title}}{{else}}{{t "The day so far"}}{{/if}}</h2>
                        <ol class="tl" role="list" data-timeline>
                            {{#foreach posts from="2" to="6"}}{{> "timeline-item"}}{{/foreach}}
                        </ol>
                    </aside>
                {{/match}}
            </section>

            {{!-- Passes the lead story so Editor's choice never repeats it. --}}
            {{#if @custom.show_editors_choice}}{{#foreach posts limit="1"}}{{> "editors-choice" lead=id}}{{/foreach}}{{/if}}
            {{#if @custom.show_desks}}{{> "desks"}}{{/if}}

            {{#match posts.length ">" 6}}
                <section class="more" aria-labelledby="more-heading">
                    <header class="section-head wrap">
                        <h2 class="section-title" id="more-heading">{{t "More stories"}}</h2>
                    </header>
                    <div class="grid wrap">
                        {{#foreach posts from="7"}}{{> "card"}}{{/foreach}}
                    </div>
                </section>
            {{/match}}

            {{pagination}}
        {{else}}
            <div class="empty wrap">
                <h2 class="empty-title">{{t "Nothing published yet"}}</h2>
                <p>{{t "Publish a post and it will lead this page. The ones after it fill the timeline."}}</p>
            </div>
        {{/if}}
    {{/is}}
</main>
