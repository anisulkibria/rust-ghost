{{!< default}}
<main id="main" class="pl-journal">
{{#author}}
<header class="pl-wrap pl-authorhead">
<div class="pl-author-card">
<span class="pl-author-photo">{{#if profile_image}}<img src="{{img_url profile_image size="m"}}" alt="{{name}}">{{else}}<span>{{name}}</span>{{/if}}</span>
<div class="pl-author-copy">
<p class="pl-kicker">Written by</p>
<h1 class="pl-jtitle">{{name}}</h1>
{{#if bio}}<p class="pl-sub">{{bio}}</p>{{/if}}
<p class="pl-author-meta">
{{#if location}}<span>{{> "icon" name="pin" size="16"}}{{location}}</span>{{/if}}
<span>{{plural ../pagination.total empty="No stories yet" singular="% story" plural="% stories"}}</span>
{{#if website}}<a href="{{website}}" rel="noopener">{{> "icon" name="arrow" size="16"}}Website</a>{{/if}}
{{#if twitter}}<a href="{{twitter_url}}" rel="noopener">X</a>{{/if}}
{{#if facebook}}<a href="{{facebook_url}}" rel="noopener">Facebook</a>{{/if}}
</p>
</div>
</div>
{{#if cover_image}}<img class="pl-author-cover" src="{{img_url cover_image size="xl"}}" alt="">{{/if}}
</header>
{{/author}}
<section class="pl-wrap pl-section-tight">
<div class="pl-post-grid">{{#foreach posts}}{{> "post-card"}}{{/foreach}}</div>
{{> "pager"}}
</section>
</main>
