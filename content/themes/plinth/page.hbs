{{!< default}}
{{#post}}
<main id="main" class="pl-article">
{{#match @page.show_title_and_feature_image}}
<header class="pl-wrap pl-article-head"><h1 class="pl-display">{{title}}</h1>{{#if custom_excerpt}}<p class="pl-sub">{{custom_excerpt}}</p>{{/if}}</header>
{{#if feature_image}}<figure class="pl-wrap pl-article-img"><img src="{{img_url feature_image size="xl"}}" alt="{{title}}"></figure>{{/if}}
{{/match}}
<article class="pl-prose gh-content">{{content}}</article>
</main>
{{/post}}
