{{!< default}}

<main class="site-main" id="main">
    {{#author}}
        <header class="archive-header author-header wrap">
            {{#if profile_image}}
                <img class="author-portrait" src="{{img_url profile_image size="s"}}" alt="" width="160" height="160">
            {{/if}}
            <div class="archive-text">
                <p class="archive-kind">{{t "Writer"}}</p>
                <h1 class="archive-title">{{name}}</h1>
                {{#if bio}}<p class="archive-dek">{{bio}}</p>{{/if}}
                <ul class="author-links" role="list">
                    <li>{{plural ../pagination.total empty=(t "No stories yet") singular=(t "1 story") plural=(t "% stories")}}</li>
                    {{#if location}}<li>{{location}}</li>{{/if}}
                    {{#if website}}<li><a href="{{website}}" target="_blank" rel="noopener">{{readable_url website}}</a></li>{{/if}}
                    {{#if twitter}}<li><a href="{{social_url type="x"}}" target="_blank" rel="noopener">X</a></li>{{/if}}
                    {{#if facebook}}<li><a href="{{social_url type="facebook"}}" target="_blank" rel="noopener">Facebook</a></li>{{/if}}
                    {{#if bluesky}}<li><a href="{{social_url type="bluesky"}}" target="_blank" rel="noopener">Bluesky</a></li>{{/if}}
                    {{#if mastodon}}<li><a href="{{social_url type="mastodon"}}" target="_blank" rel="noopener">Mastodon</a></li>{{/if}}
                    {{#if instagram}}<li><a href="{{social_url type="instagram"}}" target="_blank" rel="noopener">Instagram</a></li>{{/if}}
                    {{#if linkedin}}<li><a href="{{social_url type="linkedin"}}" target="_blank" rel="noopener">LinkedIn</a></li>{{/if}}
                </ul>
            </div>
        </header>
    {{/author}}

    <div class="grid wrap">
        {{#foreach posts}}{{> "card"}}{{/foreach}}
    </div>

    {{pagination}}
</main>
