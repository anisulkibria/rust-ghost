{{!< default}}

<main class="site-main" id="main">
    {{#is "paged"}}
        <header class="list-header wrap">
            <h1 class="list-title">{{t "All stories"}}</h1>
            <p class="list-meta">{{t "Page {page} of {pages}" page=pagination.page pages=pagination.pages}}</p>
        </header>

        <div class="grid wrap">
            {{#foreach posts}}{{> "card"}}{{/foreach}}
        </div>
        {{pagination}}
    {{else}}
        <h1 class="visually-hidden">{{@site.title}}</h1>

        {{#if posts}}
            {{#if @custom.show_topics}}{{> "topics" topic_limit="5"}}{{/if}}

            <section class="lead wrap" aria-labelledby="lead-heading">
                <h2 class="visually-hidden" id="lead-heading">{{t "Latest stories"}}</h2>
                <div class="lead-main">
                    {{#foreach posts limit="1"}}{{> "card" size="wide"}}{{/foreach}}
                </div>
                {{#match posts.length ">" 1}}
                    <div class="lead-side">
                        {{#foreach posts from="2" to="4"}}{{> "card" size="side"}}{{/foreach}}
                    </div>
                {{/match}}
            </section>

            {{#match posts.length ">" 4}}
                <section class="recent" aria-labelledby="recent-heading">
                    <header class="section-head wrap">
                        <h2 class="section-title" id="recent-heading">{{t "Recent stories"}}</h2>
                    </header>
                    <div class="grid wrap">
                        {{#foreach posts from="5"}}{{> "card"}}{{/foreach}}
                    </div>
                </section>
            {{/match}}

            {{pagination}}

            {{#if @custom.show_picks}}{{> "picks"}}{{/if}}
            {{#if @custom.show_writers}}{{> "writers"}}{{/if}}
        {{else}}
            <div class="empty wrap">
                <h2 class="empty-title">{{t "Nothing published yet"}}</h2>
                <p>{{t "Publish a post and give it a tag. Your topics will open this page."}}</p>
            </div>
        {{/if}}
    {{/is}}
</main>
