{{!< default}}

<main class="site-main" id="main">
    <section class="error-page wrap">
        <p class="archive-kind">{{t "Error"}} {{statusCode}}</p>
        <h1 class="archive-title">{{#if message}}{{message}}{{else}}{{t "Something went wrong"}}{{/if}}</h1>
        <p class="archive-dek">{{t "Reload the page in a moment. If it keeps happening, go back to the front page."}}</p>
        <p class="error-actions">
            <a class="button" href="{{@site.url}}">{{t "Go to the front page"}}</a>
        </p>

        {{#if errorDetails}}
            <section class="error-stack" aria-label="{{t "Theme errors"}}">
                <ul>
                    {{#foreach errorDetails}}
                        <li><strong>{{{rule}}}</strong>{{#foreach failures}}<br>{{ref}}: {{message}}{{/foreach}}</li>
                    {{/foreach}}
                </ul>
            </section>
        {{/if}}
    </section>
</main>
