<p class="np-byline">{{#unless nobyline}}<span class="np-by">By {{#foreach authors limit="2"}}<a href="{{url}}">{{name}}</a>{{#unless @last}}, {{/unless}}{{/foreach}}</span>{{/unless}}{{#unless nodate}}<time datetime="{{date format="YYYY-MM-DD"}}">{{date format="MMM D, YYYY"}}</time>{{/unless}}{{#if read}}<span>{{reading_time minute="1 min read" minutes="% min read"}}</span>{{/if}}</p>
