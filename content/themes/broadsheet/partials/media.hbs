{{!-- The story's picture; posts tagged #video get a play button. --}}
<a class="np-media{{#if ratio}} np-r-{{ratio}}{{/if}}" href="{{url}}" tabindex="-1" aria-hidden="true">
{{#if feature_image}}<img src="{{img_url feature_image size="m"}}" alt="" loading="lazy">{{else}}<span class="np-noimg">{{#if primary_tag}}{{primary_tag.name}}{{else}}{{@site.title}}{{/if}}</span>{{/if}}
{{#has tag="#video"}}<span class="np-play{{#if small}} is-small{{/if}}">{{> "icon" name="play" size="18"}}</span>{{/has}}
</a>
