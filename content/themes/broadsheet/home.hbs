{{!< default}}
{{!-- Featured stories open the front page, followed by sections for public tags. --}}
<main id="main" class="np-home">

{{!-- Front: briefs | lead | more to read ------------------------------ --}}
<section class="np-wrap np-front" aria-label="Top stories">
<div class="np-front-l">
{{#get "posts" filter="featured:false" limit="2" include="tags,authors" as |briefs|}}
{{#foreach briefs}}{{> "story" layout="top" size="m"}}{{/foreach}}
{{/get}}
{{#if @custom.editor_note}}
<aside class="np-note">
<p class="np-label">Editor’s note</p>
<p class="np-note-text">{{@custom.editor_note}}</p>
{{#if @custom.editor_note_by}}<p class="np-label np-note-by">— {{@custom.editor_note_by}}</p>{{/if}}
</aside>
{{/if}}
{{recommendations}}
</div>

<div class="np-front-c">
{{#get "posts" filter="featured:true" limit="1" include="tags,authors" as |lead|}}
{{#foreach lead}}
<article class="np-lead {{post_class}}">
{{> "kicker"}}
<h1 class="np-lead-title"><a href="{{url}}">{{title}}</a></h1>
{{#if custom_excerpt}}<p class="np-dek">{{custom_excerpt}}</p>{{/if}}
{{> "media" ratio="lead"}}
<div class="np-lead-meta">{{> "byline" read=true}}<button class="np-save" type="button" data-np-save data-url="{{url}}" data-title="{{title}}">{{> "icon" name="bookmark" size="14"}}<span>Save</span></button></div>
</article>
{{/foreach}}
{{/get}}
<div class="np-front-pair">
{{#get "posts" filter="featured:true" limit="3" include="tags,authors" as |second|}}
{{#foreach second from="2"}}{{> "story" layout="top" size="m" excerpt=true}}{{/foreach}}
{{/get}}
</div>
</div>

<div class="np-front-r">
<div class="np-more-read">
<h2 class="np-label np-rail-title">More to read</h2>
<ol class="np-numbered">
{{#get "posts" limit="10" include="tags" as |more|}}{{#foreach more from="6" to="10"}}
<li><span class="np-num">{{#match @number "<" 10}}0{{/match}}{{@number}}</span><div>{{> "kicker"}}<h3 class="np-headline np-h-s"><a href="{{url}}">{{title}}</a></h3></div></li>
{{/foreach}}{{/get}}
</ol>
</div>
{{#if @site.members_enabled}}{{#unless @member}}
<form class="np-box np-signup" data-members-form="subscribe">
<p class="np-kicker"><span>Sign up</span></p>
<h3 class="np-box-title">Stay informed</h3>
<p>A daily briefing on the stories our editors are watching.</p>
<label class="np-sr" for="np-side-email">Email</label>
<input id="np-side-email" data-members-email type="email" placeholder="your@email.com" required>
<button class="np-btn np-btn-ink" type="submit">Subscribe</button>
<p class="np-form-ok">Check your inbox to confirm.</p><p class="np-form-err">Something went wrong. Try again.</p>
</form>
{{/unless}}{{/if}}
{{#if @custom.sponsor_name}}
<aside class="np-box np-sponsor">
<p class="np-label">From <em>our sponsor</em></p>
<p><b>{{@custom.sponsor_name}}</b> {{@custom.sponsor_text}}</p>
<ul>{{#foreach (split @custom.sponsor_perks separator="|")}}<li>{{this}}</li>{{/foreach}}</ul>
<a class="np-btn np-btn-ink" href="{{@custom.sponsor_url}}" rel="sponsored noopener">{{@custom.sponsor_button}}</a>
</aside>
{{/if}}
</div>
</section>

{{!-- Editor's Picks --------------------------------------------------- --}}
{{#get "posts" filter="featured:true" limit="12" include="tags,authors" as |picks|}}
<section class="np-section" data-np-rail-wrap>
<div class="np-wrap">
{{> "section-head" title="Editor’s Picks" sub="Hand-picked stories from the newsroom" arrows=true}}
<div class="np-rail np-rail-4" data-np-rail>{{#foreach picks}}{{> "story" layout="top" size="m" read=true}}{{/foreach}}</div>
</div>
</section>
{{/get}}

{{#with (split @custom.homepage_section_tags separator="," trim=true unique=true) as |section_slugs|}}
{{#foreach section_slugs as |section_slug|}}
{{#get "tags" slug=section_slug as |section_tags|}}
{{#foreach section_tags}}{{> "tag-section"}}{{/foreach}}
{{/get}}
{{/foreach}}
{{else}}
{{#get "tags" order="count.posts desc" limit="8" as |section_tags|}}
{{#foreach section_tags}}{{> "tag-section"}}{{/foreach}}
{{/get}}
{{/with}}

{{!-- From the Archive: the paginated list ------------------------------- --}}
{{#if posts}}
<section class="np-section">
<div class="np-wrap">
{{> "section-head" title="From the Archive"}}
<div class="np-grid-4">{{#foreach posts limit="8"}}{{> "story" layout="top" size="m" excerpt=true}}{{/foreach}}</div>
{{> "pager"}}
</div>
</section>
{{/if}}

{{> "membership"}}
</main>
