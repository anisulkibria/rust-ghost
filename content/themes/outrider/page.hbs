{{!< default}}
{{#post}}
<main id="main" class="or-article">
{{#match @page.show_title_and_feature_image}}
<header class="or-wrap or-article-head"><p class="or-label">{{@site.title}}</p><h1 class="or-article-title" data-or-stretch>{{title}}</h1>{{#if custom_excerpt}}<p class="or-article-dek">{{custom_excerpt}}</p>{{/if}}</header>
{{#if feature_image}}<figure class="or-article-img" data-or-parallax><img src="{{img_url feature_image size="xl"}}" alt="{{title}}"></figure>{{/if}}
{{/match}}
<article class="or-prose gh-content">{{content}}</article>
</main>
{{/post}}
