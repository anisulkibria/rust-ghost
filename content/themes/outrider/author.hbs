{{!< default}}
<main id="main" class="or-wrap or-listing">
{{#author}}
<header class="or-person-head">
<span class="or-person-photo or-person-photo-lg">{{#if profile_image}}<img src="{{img_url profile_image size="m"}}" alt="{{name}}">{{else}}<span>{{name}}</span>{{/if}}</span>
<div><p class="or-label">{{#if location}}{{location}}{{else}}{{@site.title}}{{/if}}</p><h1 class="or-list-title" data-or-stretch>{{name}}</h1>{{#if bio}}<p class="or-hero-text">{{bio}}</p>{{/if}}
<p class="or-person-links">{{#if website}}<a class="or-ul" href="{{website}}" rel="noopener">Website ↗</a>{{/if}}{{#if twitter}}<a class="or-ul" href="{{twitter_url}}" rel="noopener">X ↗</a>{{/if}}</p></div>
</header>
{{/author}}
<div class="or-post-grid">{{#foreach posts}}{{#has tag="#work"}}{{> "work-card"}}{{else}}{{> "post-card"}}{{/has}}{{/foreach}}</div>
{{> "pager"}}
</main>
