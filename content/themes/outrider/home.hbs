{{!< default}}
{{!-- The studio homepage. Content comes from the editor through internal
     tags: #work (case studies), #service, #testimonial. The team is the
     site's staff. Words live in Settings → Design. Empty blocks hide. --}}
<main id="main" class="or-home">

{{!-- Hero ------------------------------------------------------------ --}}
<section class="or-hero" aria-labelledby="or-hero-h">
<div class="or-hero-grid" aria-hidden="true"></div>
<div class="or-hero-glow" aria-hidden="true"></div>
<div class="or-wrap or-hero-in">
<p class="or-label or-hero-kicker"><span class="or-dot"></span>{{@site.title}} — {{@custom.location}}</p>
<h1 class="or-hero-title" id="or-hero-h" data-or-stretch>{{#foreach (split @custom.hero_title separator=" ")}}<span class="or-w{{#if @last}} is-accent{{/if}}" style="--i: {{@index}}">{{this}}</span> {{/foreach}}</h1>
<div class="or-hero-foot">
<p class="or-hero-text">{{@custom.hero_text}}</p>
<div class="or-hero-actions">
<a class="or-btn or-btn-accent or-btn-lg" href="mailto:{{@custom.contact_email}}" data-or-magnet>{{@custom.cta_label}}<span class="or-btn-arrow" aria-hidden="true">↗</span></a>
<a class="or-btn or-btn-line or-btn-lg" href="#work">See the work</a>
</div>
<a class="or-roll" href="#work" aria-label="Scroll to the work">
<svg viewBox="0 0 120 120" aria-hidden="true"><defs><path id="or-roll-path" d="M60 60m-46 0a46 46 0 1 1 92 0a46 46 0 1 1-92 0"/></defs><text><textPath href="#or-roll-path">SCROLL · SEE THE WORK · SCROLL · SEE THE WORK · </textPath></text></svg>
<span>↓</span>
</a>
</div>
</div>
{{#get "posts" filter="tag:hash-work" limit="6" as |reel|}}
<div class="or-reel" aria-hidden="true">
<div class="or-reel-track">
{{#foreach reel}}{{#if feature_image}}<img src="{{img_url feature_image size="m"}}" alt="" loading="lazy">{{/if}}{{/foreach}}
{{#foreach reel}}{{#if feature_image}}<img src="{{img_url feature_image size="m"}}" alt="" loading="lazy">{{/if}}{{/foreach}}
</div>
</div>
{{/get}}
</section>

{{!-- Clients ---------------------------------------------------------- --}}
{{#if @custom.clients}}
<section class="or-clients" aria-label="Clients">
<p class="or-wrap or-label">Trusted by teams who ship</p>
<div class="or-marquee"><div class="or-marquee-track">
{{#foreach (split @custom.clients separator="|")}}<span class="or-client or-client-{{@index}}">{{this}}</span>{{/foreach}}
{{#foreach (split @custom.clients separator="|")}}<span class="or-client or-client-{{@index}}" aria-hidden="true">{{this}}</span>{{/foreach}}
</div></div>
</section>
{{/if}}

{{!-- About + stats ---------------------------------------------------- --}}
<section class="or-wrap or-section or-about" aria-labelledby="or-about-h">
<p class="or-label">(01) The studio</p>
<h2 class="or-statement" id="or-about-h" data-or-words>{{#if @site.description}}{{@site.description}}{{else}}We are designers, strategists and engineers who believe the best brands are built, not decorated.{{/if}}</h2>
{{#if @custom.stats}}
<dl class="or-stats">
{{#foreach (split @custom.stats separator="|")}}
<div class="or-stat">{{#foreach (split this separator=":")}}{{#if @first}}<dt data-or-count>{{this}}</dt>{{else}}<dd>{{this}}</dd>{{/if}}{{/foreach}}</div>
{{/foreach}}
</dl>
{{/if}}
</section>

{{!-- Services --------------------------------------------------------- --}}
{{#get "posts" filter="tag:hash-service" limit="8" order="published_at asc" as |services|}}
<section class="or-services" aria-labelledby="or-services-h">
<div class="or-wrap">
<div class="or-head"><p class="or-label">(02) What we do</p><h2 class="or-h2" id="or-services-h">Services</h2></div>
<ol class="or-svc-list">
{{#foreach services}}
<li class="or-svc">
<a class="or-svc-row" href="{{url}}">
<span class="or-svc-n">{{#match @number "<" 10}}0{{/match}}{{@number}}</span>
<span class="or-svc-name">{{title}}</span>
<span class="or-svc-text">{{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{excerpt words="18"}}{{/if}}</span>
<span class="or-svc-go" aria-hidden="true">↗</span>
{{#if feature_image}}<img class="or-svc-peek" src="{{img_url feature_image size="s"}}" alt="" loading="lazy">{{/if}}
</a>
</li>
{{/foreach}}
</ol>
</div>
</section>
{{/get}}

{{!-- Work ------------------------------------------------------------- --}}
{{#get "posts" filter="tag:hash-work" limit="6" include="tags" as |work|}}
<section class="or-wrap or-section" id="work" aria-labelledby="or-work-h">
<div class="or-head or-head-row"><div><p class="or-label">(03) Selected work</p><h2 class="or-h2" id="or-work-h">Case studies</h2></div>{{#get "pages" filter="slug:work" limit="1" as |w|}}{{#foreach w}}<a class="or-btn or-btn-line" href="{{url}}">All work ↗</a>{{/foreach}}{{/get}}</div>
<div class="or-work-grid">
{{#foreach work}}{{> "work-card"}}{{/foreach}}
</div>
</section>
{{/get}}

{{!-- Process ---------------------------------------------------------- --}}
{{#if @custom.process}}
<section class="or-wrap or-section or-process" aria-labelledby="or-process-h">
<div class="or-head"><p class="or-label">(04) How we work</p><h2 class="or-h2" id="or-process-h">One process, <em>no surprises</em></h2></div>
<ol class="or-steps">
{{#foreach (split @custom.process separator="|") limit="6"}}
<li class="or-step">
<span class="or-step-n">{{@number}}</span>
{{#foreach (split this separator=":")}}{{#if @first}}<h3>{{this}}</h3>{{else}}<p>{{this}}</p>{{/if}}{{/foreach}}
<span class="or-step-bar" aria-hidden="true"></span>
</li>
{{/foreach}}
</ol>
</section>
{{/if}}

{{!-- Testimonials -------------------------------------------------- --}}
{{#get "posts" filter="tag:hash-testimonial" limit="6" as |voices|}}
<section class="or-voices" aria-labelledby="or-voices-h" data-or-slider>
<div class="or-wrap">
<div class="or-head or-head-row"><div><p class="or-label">(05) Kind words</p><h2 class="or-h2" id="or-voices-h">Clients say</h2></div>
<div class="or-slider-btns"><button class="or-round" type="button" data-or-prev aria-label="Previous">←</button><button class="or-round" type="button" data-or-next aria-label="Next">→</button></div></div>
<div class="or-voice-stage">
{{#foreach voices}}
<figure class="or-voice{{#if @first}} is-on{{/if}}">
<blockquote>“{{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{excerpt words="50"}}{{/if}}”</blockquote>
<figcaption>{{#if feature_image}}<img src="{{img_url feature_image size="s"}}" alt="">{{else}}<span class="or-voice-init">{{title}}</span>{{/if}}<span><b>{{title}}</b>{{#if primary_tag}}{{#match primary_tag.visibility "public"}}<small>{{primary_tag.name}}</small>{{/match}}{{/if}}</span></figcaption>
</figure>
{{/foreach}}
</div>
<p class="or-voice-count or-label"><span data-or-current>01</span> / <span data-or-total>01</span></p>
</div>
</section>
{{/get}}

{{!-- Team ------------------------------------------------------------- --}}
{{#get "authors" limit="8" as |team|}}
<section class="or-wrap or-section" aria-labelledby="or-team-h">
<div class="or-head"><p class="or-label">(06) The people</p><h2 class="or-h2" id="or-team-h">Small team, <em>senior hands</em></h2></div>
<div class="or-team">
{{#foreach team}}
<a class="or-person" href="{{url}}">
<span class="or-person-photo">{{#if profile_image}}<img src="{{img_url profile_image size="m"}}" alt="" loading="lazy">{{else}}<span>{{name}}</span>{{/if}}</span>
<b>{{name}}</b>
<small>{{#if location}}{{location}}{{else}}{{@site.title}}{{/if}}</small>
</a>
{{/foreach}}
</div>
</section>
{{/get}}

{{!-- Journal ---------------------------------------------------------- --}}
{{#get "posts" filter="tag:-hash-work+tag:-hash-service+tag:-hash-testimonial" limit="3" include="tags" as |notes|}}
<section class="or-wrap or-section" aria-labelledby="or-journal-h">
<div class="or-head or-head-row"><div><p class="or-label">(07) Journal</p><h2 class="or-h2" id="or-journal-h">Notes from the studio</h2></div>{{#get "pages" filter="slug:journal" limit="1" as |j|}}{{#foreach j}}<a class="or-btn or-btn-line" href="{{url}}">All notes ↗</a>{{/foreach}}{{/get}}</div>
<div class="or-post-grid">{{#foreach notes}}{{> "post-card"}}{{/foreach}}</div>
</section>
{{/get}}

</main>
