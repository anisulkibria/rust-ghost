<footer class="or-footer">
<div class="or-wrap">
<div class="or-footer-cta">
<p class="or-label">Have something in mind?</p>
<a class="or-footer-big" href="mailto:{{@custom.contact_email}}" data-or-magnet><span>Let’s talk</span><span class="or-footer-arrow" aria-hidden="true">↗</span></a>
</div>
<div class="or-footer-grid">
<div><p class="or-label">Write</p><a class="or-ul" href="mailto:{{@custom.contact_email}}">{{@custom.contact_email}}</a></div>
<div><p class="or-label">Studio</p><p>{{@custom.location}}</p></div>
<nav aria-label="Footer"><p class="or-label">Explore</p>{{#foreach @site.navigation}}<a class="or-ul" href="{{url absolute="true"}}">{{label}}</a>{{/foreach}}{{#foreach @site.secondary_navigation}}<a class="or-ul" href="{{url absolute="true"}}">{{label}}</a>{{/foreach}}</nav>
<div><p class="or-label">Follow</p>{{#if @site.twitter}}<a class="or-ul" href="{{twitter_url @site.twitter}}" rel="noopener">X / Twitter</a>{{/if}}{{#if @site.facebook}}<a class="or-ul" href="{{facebook_url @site.facebook}}" rel="noopener">Facebook</a>{{/if}}<a class="or-ul" href="{{@site.url}}/rss/">RSS</a></div>
</div>
<div class="or-footer-legal"><span>© {{date format="YYYY"}} {{@site.title}}</span><span>Outrider theme on <a class="or-ul" href="https://vuuut.com" rel="noopener">Vuuut</a></span><a class="or-ul" href="#top" data-or-top>Back to top ↑</a></div>
</div>
<p class="or-footer-word" aria-hidden="true" data-or-stretch>{{@site.title}}</p>
</footer>
