{{!-- A case study: a post tagged #work. Its first public tag is the
     discipline; the excerpt is the one-line result. --}}
<article class="or-work">
<a class="or-work-link" href="{{url}}" data-or-view>
<span class="or-work-art">{{#if feature_image}}<img src="{{img_url feature_image size="l"}}" srcset="{{img_url feature_image size="m"}} 800w, {{img_url feature_image size="l"}} 1200w, {{img_url feature_image size="xl"}} 1800w" sizes="(max-width: 900px) 100vw, 60vw" alt="" loading="lazy">{{else}}<span class="or-work-blank">{{title}}</span>{{/if}}</span>
<span class="or-work-meta">
<span class="or-work-title">{{title}}</span>
<span class="or-work-tags">{{#foreach tags}}{{#match visibility "public"}}<span>{{name}}</span>{{/match}}{{/foreach}}<span>{{date format="YYYY"}}</span></span>
</span>
{{#if custom_excerpt}}<span class="or-work-line">{{custom_excerpt}}</span>{{/if}}
</a>
</article>
