<article class="or-post {{post_class}}">
<a class="or-post-link" href="{{url}}">
<span class="or-post-art">{{#if feature_image}}<img src="{{img_url feature_image size="m"}}" alt="" loading="lazy">{{else}}<span class="or-work-blank">{{title}}</span>{{/if}}</span>
<span class="or-post-meta"><span>{{#if primary_tag}}{{primary_tag.name}}{{else}}Journal{{/if}}</span><time datetime="{{date format="YYYY-MM-DD"}}">{{date format="D MMM YYYY"}}</time></span>
<span class="or-post-title">{{title}}</span>
<span class="or-post-more" aria-hidden="true">Read ↗</span>
</a>
</article>
