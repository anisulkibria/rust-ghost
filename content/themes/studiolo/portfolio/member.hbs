{{!< default}}
<main id="main" class="sl-main">
{{#member}}
<section class="sl-wrap sl-about">
<div class="sl-about-copy">
<a class="sl-back" href="{{../portfolio.about_url}}">{{> "icon" name="left" size="15"}} The studio</a>
<p class="sl-eyebrow">{{role}}</p>
<h1 class="sl-h1">{{name}}</h1>
{{#if bio}}<p class="sl-lede">{{bio}}</p>{{/if}}
{{#if links}}<div class="sl-hero-actions">{{#foreach links}}<a class="sl-link" href="{{this}}" target="_blank" rel="noopener">{{this}}</a>{{/foreach}}</div>{{/if}}
</div>
{{#if photo}}<figure class="sl-about-pic"><img src="{{photo}}" alt="{{name}}"></figure>{{/if}}
</section>
{{/member}}
{{#if projects}}<section class="sl-wrap sl-block"><div class="sl-block-head"><h2 class="sl-h2">Projects</h2></div><div class="sl-grid">{{#foreach projects}}{{> "project-card"}}{{/foreach}}</div></section>{{/if}}
</main>
