{{!< default}}
<main id="main" class="sl-main">
{{#author}}<header class="sl-wrap sl-page-head sl-author">{{#if profile_image}}<img src="{{img_url profile_image size="s"}}" alt="">{{/if}}<div><p class="sl-eyebrow">Writing by</p><h1 class="sl-h1">{{name}}</h1>{{#if bio}}<p class="sl-lede">{{bio}}</p>{{/if}}</div></header>{{/author}}
<section class="sl-wrap sl-block sl-block-top"><div class="sl-posts">{{#foreach posts}}{{> "post-card"}}{{/foreach}}</div>{{> "pager"}}</section>
</main>
