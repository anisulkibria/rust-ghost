<a class="sl-ix-row" href="{{url}}" data-sl-preview="{{feature_image}}">
<span class="sl-ix-n">{{#if year}}{{year}}{{else}}—{{/if}}</span>
<span class="sl-ix-t">{{title}}{{#if locked}} {{> "icon" name="lock" size="14"}}{{/if}}</span>
<span class="sl-ix-c">{{client}}</span>
<span class="sl-ix-k">{{primary_category}}</span>
<span class="sl-ix-go">{{> "icon" name="arrow" size="18"}}</span>
</a>
