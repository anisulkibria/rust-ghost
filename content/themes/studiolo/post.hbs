{{!< default}}
{{#post}}
<main id="main" class="sl-main">
<article class="sl-article {{post_class}}">
<header class="sl-narrow sl-article-head">
<p class="sl-card-meta">{{#if primary_tag}}<a href="{{primary_tag.url}}">{{primary_tag.name}}</a>{{/if}}<span><time datetime="{{date format="YYYY-MM-DD"}}">{{date format="D MMMM YYYY"}}</time></span><span>{{reading_time minute="1 min read" minutes="% min read"}}</span></p>
<h1 class="sl-h1">{{title}}</h1>
{{#if custom_excerpt}}<p class="sl-lede">{{custom_excerpt}}</p>{{/if}}
</header>
{{#if feature_image}}<figure class="sl-wrap sl-article-img"><img src="{{img_url feature_image size="l"}}" srcset="{{img_url feature_image size="m"}} 720w, {{img_url feature_image size="l"}} 1200w, {{img_url feature_image size="xl"}} 2000w" sizes="(max-width: 1200px) 100vw, 1200px" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}">{{#if feature_image_caption}}<figcaption>{{feature_image_caption}}</figcaption>{{/if}}</figure>{{/if}}
<div class="sl-content gh-content">{{content}}</div>
<div class="sl-narrow sl-comments">{{comments}}</div>
</article>
{{#get "posts" filter="id:-{{id}}" limit="3" include="tags"}}{{#if posts}}
<section class="sl-wrap sl-block"><div class="sl-block-head"><h2 class="sl-h2">More writing</h2></div><div class="sl-posts">{{#foreach posts}}{{> "post-card"}}{{/foreach}}</div></section>
{{/if}}{{/get}}
</main>
{{/post}}
