{{!< default}}
{{!-- An author is an instructor: their courses (each also sold in the store)
      lead the page, their writing follows. Course stats are summed by
      lingua-atlas.js from the cards' data attributes. --}}
<main id="main" class="listing-page instructor">
    {{#author}}
    <section class="cat-hero ins-hero">
        <div class="wrap ins-grid">
            <div class="ins-photo">{{#if profile_image}}<img src="{{img_url profile_image size="m"}}" alt="{{name}}">{{else}}<span>{{name}}</span>{{/if}}</div>
            <div class="ins-copy">
                <p class="eyebrow">Instructor</p>
                <h1>{{name}}</h1>
                {{#if bio}}<p class="lede">{{bio}}</p>{{else}}<p class="lede">Teaches at {{@site.title}} — practical courses you can finish and use.</p>{{/if}}
                <div class="dash-stats ins-stats" data-ins-stats hidden>
                    <div><b data-sum="courses">0</b><span>courses</span></div>
                    <div><b data-sum="students">0</b><span>students</span></div>
                    <div><b data-sum="rating">–</b><span>average rating <i class="ins-star">★</i></span></div>
                </div>
                <p class="ins-links">
                    {{#if website}}<a class="btn btn-quiet" href="{{website}}" target="_blank" rel="noopener">Website</a>{{/if}}
                    {{#if location}}<span class="ins-loc">{{location}}</span>{{/if}}
                </p>
            </div>
        </div>
    </section>

    {{#get "courses" filter="instructor.slug:{{slug}}" limit="100" as |taught|}}
    <section class="wrap band-tight" id="courses">
        <header class="band-head"><div><p class="eyebrow">Teaching</p><h2>Courses by {{../name}}</h2></div></header>
        <div class="course-grid" data-ins-courses>
            {{#foreach taught}}<div class="ins-card" data-students="{{students}}" data-rating="{{rating}}" data-reviews="{{reviews}}">{{> "course-card"}}</div>{{/foreach}}
        </div>
    </section>
    {{/get}}
    {{/author}}

    {{#if posts}}
    <section class="wrap band">
        <header class="band-head"><div><p class="eyebrow">Writing</p><h2>Notes and articles</h2></div></header>
        <div class="post-grid">{{#foreach posts}}{{> "post-card"}}{{/foreach}}</div>
    </section>
    {{> "pagination"}}
    {{/if}}
</main>
