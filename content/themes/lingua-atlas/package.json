{
    "name": "lingua-atlas",
    "description": "An editorial language-learning theme for Arabic, English and French courses on Vuuut.",
    "version": "1.0.0",
    "engines": {
        "ghost": ">=5.0.0"
    },
    "license": "MIT",
    "author": {
        "name": "Vuuut",
        "email": "hello@vuuut.com",
        "url": "https://vuuut.com"
    },
    "gpm": {
        "type": "theme",
        "categories": [
            "Education",
            "Business"
        ]
    },
    "keywords": [
        "ghost-theme",
        "vuuut-theme",
        "lms",
        "education",
        "language-learning"
    ],
    "config": {
        "posts_per_page": 9,
        "image_sizes": {
            "xs": {
                "width": 160
            },
            "s": {
                "width": 400
            },
            "m": {
                "width": 760
            },
            "l": {
                "width": 1200
            },
            "xl": {
                "width": 1800
            },
            "xxl": {
                "width": 2400
            }
        },
        "card_assets": true,
        "custom": {
            "color_scheme": {
                "type": "select",
                "options": [
                    "Light",
                    "Dark",
                    "Follow the reader's device"
                ],
                "default": "Light",
                "description": "Where every reader starts. Each can switch with the light/dark button."
            },
            "use_site_accent": {
                "type": "boolean",
                "default": false,
                "description": "Use the site accent colour for primary buttons."
            },
            "catalog_address": {
                "type": "text",
                "default": "/courses/",
                "description": "Address of the course catalogue, as set in Tools → LMS & Online Courses."
            },
            "hero_heading": {
                "type": "text",
                "description": "Optional homepage headline. Leave blank for “Learn a language. Make it yours.”"
            },
            "hero_text": {
                "type": "text",
                "description": "Optional introduction below the homepage headline."
            },
            "hero_image": {
                "type": "image",
                "description": "Optional replacement for the homepage phrasebook photograph.",
                "group": "homepage"
            },
            "show_categories": {
                "type": "boolean",
                "default": true,
                "description": "Show Arabic, English and French categories with published courses.",
                "group": "homepage"
            },
            "show_journal": {
                "type": "boolean",
                "default": false,
                "description": "Shows your latest posts on the homepage.",
                "group": "homepage"
            },
            "journal_tag": {
                "type": "text",
                "description": "Optional tag slug for the homepage journal, such as language-journal. Blank shows the latest posts.",
                "group": "homepage"
            },
            "cta_heading": {
                "type": "text",
                "default": "Ready for your first lesson?",
                "description": "Heading above the final link to the course catalogue.",
                "group": "homepage"
            }
        }
    }
}
