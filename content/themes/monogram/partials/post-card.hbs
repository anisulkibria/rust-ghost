<article class="mg-card mg-post {{post_class}}">
<a class="mg-post-art" href="{{url}}" tabindex="-1" aria-hidden="true">{{#if feature_image}}<img src="{{img_url feature_image size="m"}}" alt="" loading="lazy">{{else}}{{> "monogram" size="lg"}}{{/if}}</a>
<p class="mg-meta"><span>{{#if primary_tag}}{{primary_tag.name}}{{else}}Note{{/if}}</span><span>{{reading_time}}</span></p>
<h3 class="mg-post-title"><a href="{{url}}">{{title}}<span class="mg-arrow">{{> "icon" name="arrow" size="18"}}</span></a></h3>
</article>
