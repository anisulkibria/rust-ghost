<div class="mg-socials">
{{#if @site.twitter}}<a class="mg-soft-btn" href="{{twitter_url @site.twitter}}" rel="noopener" aria-label="X">{{> "icon" name="x"}}</a>{{/if}}
{{#if @site.facebook}}<a class="mg-soft-btn" href="{{facebook_url @site.facebook}}" rel="noopener" aria-label="Facebook">{{> "icon" name="fb"}}</a>{{/if}}
<a class="mg-soft-btn" href="mailto:{{@custom.contact_email}}" aria-label="Email">{{> "icon" name="mail"}}</a>
<a class="mg-soft-btn" href="{{@site.url}}/rss/" aria-label="RSS">{{> "icon" name="rss"}}</a>
</div>
