{{!< default}}
{{#post}}
<div class="mg-progress" aria-hidden="true"><span data-mg-progress></span></div>
<main id="main" class="mg-article">
<header class="mg-wrap mg-article-head">
<a class="mg-back mg-soft-btn" href="{{#has tag="#project"}}{{@site.url}}#work{{else}}{{@site.url}}#notes{{/has}}" aria-label="Back">←</a>
<p class="mg-kicker">{{#has tag="#project"}}Project{{else}}{{#if primary_tag}}{{primary_tag.name}}{{else}}Note{{/if}}{{/has}} · <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="D MMMM YYYY"}}</time> · {{reading_time}}</p>
<h1 class="mg-article-title">{{title}}</h1>
{{#if custom_excerpt}}<p class="mg-lead">{{custom_excerpt}}</p>{{/if}}
</header>
{{#if feature_image}}<figure class="mg-wrap mg-article-img"><div class="mg-card"><img src="{{img_url feature_image size="xl"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"></div>{{#if feature_image_caption}}<figcaption>{{feature_image_caption}}</figcaption>{{/if}}</figure>{{/if}}
<article class="mg-prose gh-content">{{content}}</article>
<footer class="mg-article-foot">
<div class="mg-card mg-author-row">
{{> "monogram"}}
<div><b>{{@custom.name}}</b><p class="mg-muted">{{#foreach (split @custom.roles separator="|") limit="1"}}{{this}}{{/foreach}}</p></div>
<a class="mg-btn mg-btn-accent" href="{{@site.url}}#contact">Work with me</a>
</div>
</footer>
{{comments}}
</main>
{{#has tag="#project"}}
{{#get "posts" filter="tag:hash-project+id:-{{id}}" limit="3" include="tags"}}{{#if posts}}
<section class="mg-wrap mg-section"><header class="mg-head"><p class="mg-kicker">More work</p><h2 class="mg-h2">Other <em>projects</em></h2></header><div class="mg-post-grid">{{#foreach posts}}{{> "post-card"}}{{/foreach}}</div></section>
{{/if}}{{/get}}
{{/has}}
{{/post}}
