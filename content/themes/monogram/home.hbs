{{!< default}}
{{!-- A one-page portfolio. Edit it as posts with internal tags:
     #service, #project (its public tag is the filter), #experience and
     #education (title = role, excerpt = "Place · years"), #testimonial
     (title = name, excerpt = the words, public tag = company).
     Name, roles, skills and contact details are in Settings → Design. --}}
<main id="main" class="mg-home">

{{!-- Hero ------------------------------------------------------------ --}}
<section class="mg-wrap mg-hero" aria-labelledby="mg-hero-h">
<div class="mg-hero-copy">
<p class="mg-kicker">Welcome to my corner of the internet</p>
<h1 class="mg-hero-title" id="mg-hero-h">Hi, I’m <em>{{@custom.name}}</em></h1>
<p class="mg-roles" aria-live="polite">a <span class="mg-role" data-mg-roles="{{@custom.roles}}">{{#foreach (split @custom.roles separator="|") limit="1"}}{{this}}{{/foreach}}</span><span class="mg-caret" aria-hidden="true"></span></p>
<p class="mg-lead">{{#if @site.description}}{{@site.description}}{{else}}I design calm, useful products and the brands around them.{{/if}}</p>
<div class="mg-hero-actions">
<a class="mg-btn mg-btn-accent mg-btn-lg" href="#contact">Hire me {{> "icon" name="arrow" size="18"}}</a>
{{#if @custom.cv_url}}<a class="mg-btn mg-btn-lg" href="{{@custom.cv_url}}" rel="noopener">{{> "icon" name="download" size="18"}} Download CV</a>{{else}}<a class="mg-btn mg-btn-lg" href="#work">See my work</a>{{/if}}
</div>
<div class="mg-hero-rows">
<div><p class="mg-kicker">Find me on</p>{{> "socials"}}</div>
{{#if @custom.skills}}<div><p class="mg-kicker">Best with</p><ul class="mg-chips">{{#foreach (split @custom.skills separator="|") limit="6"}}<li class="mg-soft-chip">{{this}}</li>{{/foreach}}</ul></div>{{/if}}
</div>
</div>
<div class="mg-hero-art">
<div class="mg-portrait">
{{#if @custom.portrait}}<img src="{{img_url @custom.portrait size="l"}}" alt="{{@custom.name}}">{{else}}{{> "monogram" size="xl"}}{{/if}}
</div>
{{#if @custom.availability}}
<span class="mg-ring" aria-hidden="true"><svg viewBox="0 0 140 140"><defs><path id="mg-ring-p" d="M70 70m-54 0a54 54 0 1 1 108 0a54 54 0 1 1-108 0"/></defs><text><textPath href="#mg-ring-p">{{@custom.availability}} · {{@custom.availability}} · </textPath></text></svg><span class="mg-ring-dot"></span></span>
{{/if}}
<span class="mg-float mg-float-1" aria-hidden="true"><b data-mg-count>{{#get "posts" filter="tag:hash-project" limit="50" as |p pg|}}{{pg.total}}{{else}}0{{/get}}</b><small>projects<br>shipped</small></span>
<span class="mg-float mg-float-2" aria-hidden="true">{{#foreach (split @custom.roles separator="|") limit="1"}}{{this}}{{/foreach}}</span>
</div>
</section>

{{!-- Services ---------------------------------------------------------- --}}
{{#get "posts" filter="tag:hash-service" limit="6" order="published_at asc" as |services|}}
<section class="mg-wrap mg-section" id="services" aria-labelledby="mg-svc-h">
<header class="mg-head"><p class="mg-kicker">What I do</p><h2 class="mg-h2" id="mg-svc-h">Services, <em>start to finish</em></h2></header>
<div class="mg-svc-grid">
{{#foreach services}}
<a class="mg-card mg-svc" href="{{url}}">
<span class="mg-svc-n">{{#match @number "<" 10}}0{{/match}}{{@number}}</span>
<h3>{{title}}</h3>
<p>{{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{excerpt words="20"}}{{/if}}</p>
<span class="mg-arrow">{{> "icon" name="arrow" size="20"}}</span>
</a>
{{/foreach}}
</div>
</section>
{{/get}}

{{!-- Work ------------------------------------------------------------- --}}
{{#get "posts" filter="tag:hash-project" limit="12" include="tags" as |projects|}}
<section class="mg-wrap mg-section" id="work" aria-labelledby="mg-work-h">
<header class="mg-head mg-head-row"><div><p class="mg-kicker">Selected work</p><h2 class="mg-h2" id="mg-work-h">Projects I’m <em>proud of</em></h2></div>
<div class="mg-filter" role="group" aria-label="Filter projects" data-mg-filter><button type="button" class="mg-filter-btn is-on" data-f="*">All</button></div></header>
<div class="mg-work-grid" data-mg-filtered>
{{#foreach projects}}
<article class="mg-card mg-project" data-tags="{{#foreach tags}}{{#match visibility "public"}}{{name}}|{{/match}}{{/foreach}}">
<a class="mg-project-art" href="{{url}}" tabindex="-1" aria-hidden="true">{{#if feature_image}}<img src="{{img_url feature_image size="m"}}" alt="" loading="lazy">{{else}}{{> "monogram" size="lg"}}{{/if}}</a>
<p class="mg-meta"><span>{{#foreach tags}}{{#match visibility "public"}}{{name}}{{/match}}{{/foreach}}</span><span>{{date format="YYYY"}}</span></p>
<h3 class="mg-project-title"><a href="{{url}}">{{title}}<span class="mg-arrow">{{> "icon" name="arrow" size="18"}}</span></a></h3>
{{#if custom_excerpt}}<p class="mg-muted">{{custom_excerpt}}</p>{{/if}}
</article>
{{/foreach}}
</div>
</section>
{{/get}}

{{!-- Résumé ------------------------------------------------------------- --}}
<section class="mg-wrap mg-section" id="resume" aria-labelledby="mg-cv-h">
<header class="mg-head mg-center"><p class="mg-kicker">Experience &amp; education</p><h2 class="mg-h2" id="mg-cv-h">My <em>résumé</em></h2></header>
<div class="mg-tabs" role="tablist" aria-label="Résumé">
<button class="mg-tab is-on" role="tab" aria-selected="true" aria-controls="mg-tab-exp" id="mg-t-exp" type="button">Experience</button>
<button class="mg-tab" role="tab" aria-selected="false" aria-controls="mg-tab-edu" id="mg-t-edu" type="button">Education</button>
<button class="mg-tab" role="tab" aria-selected="false" aria-controls="mg-tab-skl" id="mg-t-skl" type="button">Skills</button>
</div>
<div class="mg-panel" role="tabpanel" id="mg-tab-exp" aria-labelledby="mg-t-exp">
<ol class="mg-timeline">
{{#get "posts" filter="tag:hash-experience" limit="12" as |jobs|}}{{#foreach jobs}}
<li class="mg-card mg-job"><span class="mg-dot" aria-hidden="true"></span><div class="mg-job-top"><h3>{{title}}</h3>{{#if custom_excerpt}}<span class="mg-pill">{{custom_excerpt}}</span>{{/if}}</div><p>{{content words="40"}}</p></li>
{{/foreach}}{{else}}<li class="mg-muted">Tag a post <code>#experience</code> to add a role.</li>{{/get}}
</ol>
</div>
<div class="mg-panel" role="tabpanel" id="mg-tab-edu" aria-labelledby="mg-t-edu" hidden>
<ol class="mg-timeline">
{{#get "posts" filter="tag:hash-education" limit="12" as |school|}}{{#foreach school}}
<li class="mg-card mg-job"><span class="mg-dot" aria-hidden="true"></span><div class="mg-job-top"><h3>{{title}}</h3>{{#if custom_excerpt}}<span class="mg-pill">{{custom_excerpt}}</span>{{/if}}</div><p>{{content words="40"}}</p></li>
{{/foreach}}{{else}}<li class="mg-muted">Tag a post <code>#education</code> to add a school.</li>{{/get}}
</ol>
</div>
<div class="mg-panel" role="tabpanel" id="mg-tab-skl" aria-labelledby="mg-t-skl" hidden>
<ul class="mg-skills">
{{#foreach (split @custom.skill_levels separator="|")}}
<li class="mg-card mg-skill">{{#foreach (split this separator=":")}}{{#if @first}}<span class="mg-skill-name">{{this}}</span>{{else}}<span class="mg-skill-pc">{{this}}%</span><span class="mg-bar"><span style="--w: {{this}}%"></span></span>{{/if}}{{/foreach}}</li>
{{/foreach}}
</ul>
</div>
</section>

{{!-- Testimonials -------------------------------------------------- --}}
{{#get "posts" filter="tag:hash-testimonial" limit="6" include="tags" as |words|}}
<section class="mg-wrap mg-section" id="words" aria-labelledby="mg-words-h" data-mg-slider>
<header class="mg-head mg-head-row"><div><p class="mg-kicker">What clients say</p><h2 class="mg-h2" id="mg-words-h">Kind <em>words</em></h2></div>
<div class="mg-slider-btns"><button class="mg-soft-btn" type="button" data-mg-prev aria-label="Previous">←</button><button class="mg-soft-btn" type="button" data-mg-next aria-label="Next">→</button></div></header>
<div class="mg-card mg-quote-card">
{{#foreach words}}
<figure class="mg-quote{{#if @first}} is-on{{/if}}">
<div class="mg-quote-who">
<span class="mg-quote-photo">{{#if feature_image}}<img src="{{img_url feature_image size="s"}}" alt="">{{else}}<span class="mg-initial-big">{{title}}</span>{{/if}}</span>
<b>{{title}}</b>
<small>{{#foreach tags}}{{#match visibility "public"}}{{name}}{{/match}}{{/foreach}}</small>
</div>
<div class="mg-quote-body">
<span class="mg-quote-mark">{{> "icon" name="quote" size="44"}}</span>
<blockquote>{{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{excerpt words="60"}}{{/if}}</blockquote>
<span class="mg-stars" aria-label="Five stars">★★★★★</span>
</div>
</figure>
{{/foreach}}
</div>
</section>
{{/get}}

{{!-- Notes ------------------------------------------------------------- --}}
{{#get "posts" filter="tag:-[hash-service,hash-project,hash-experience,hash-education,hash-testimonial,hash-work]" limit="3" include="tags" as |notes|}}
<section class="mg-wrap mg-section" id="notes" aria-labelledby="mg-notes-h">
<header class="mg-head mg-head-row"><div><p class="mg-kicker">From the notebook</p><h2 class="mg-h2" id="mg-notes-h">Recent <em>writing</em></h2></div>{{#get "pages" filter="slug:journal" limit="1" as |j|}}{{#foreach j}}<a class="mg-btn" href="{{url}}">All notes {{> "icon" name="arrow" size="16"}}</a>{{/foreach}}{{/get}}</header>
<div class="mg-post-grid">{{#foreach notes}}{{> "post-card"}}{{/foreach}}</div>
</section>
{{/get}}

{{!-- Contact ----------------------------------------------------------- --}}
<section class="mg-wrap mg-section" id="contact" aria-labelledby="mg-contact-h">
<header class="mg-head mg-center"><p class="mg-kicker">Contact</p><h2 class="mg-h2" id="mg-contact-h">Let’s make <em>something good</em></h2></header>
<div class="mg-contact">
<aside class="mg-card mg-contact-card">
<div class="mg-contact-photo">{{#if @custom.portrait}}<img src="{{img_url @custom.portrait size="m"}}" alt="">{{else}}{{> "monogram" size="xl"}}{{/if}}</div>
<h3>{{@custom.name}}</h3>
<p class="mg-muted">{{#foreach (split @custom.roles separator="|") limit="1"}}{{this}}{{/foreach}}{{#if @custom.availability}} · {{@custom.availability}}{{/if}}</p>
{{#if @custom.phone}}<p><span class="mg-kicker">Phone</span><a href="tel:{{@custom.phone}}">{{@custom.phone}}</a></p>{{/if}}
<p><span class="mg-kicker">Email</span><a href="mailto:{{@custom.contact_email}}">{{@custom.contact_email}}</a></p>
<p class="mg-kicker">Find me on</p>{{> "socials"}}
</aside>
<form class="mg-card mg-form" action="mailto:{{@custom.contact_email}}" method="post" enctype="text/plain" data-mg-mail="{{@custom.contact_email}}">
<div class="mg-form-row">
<label class="mg-field"><span>Your name</span><input name="name" autocomplete="name" required></label>
<label class="mg-field"><span>Email</span><input name="email" type="email" autocomplete="email" required></label>
</div>
<label class="mg-field"><span>Subject</span><input name="subject" required></label>
<label class="mg-field"><span>Your message</span><textarea name="message" rows="7" required></textarea></label>
<button class="mg-btn mg-btn-accent mg-btn-lg mg-btn-wide" type="submit">Send message {{> "icon" name="send" size="18"}}</button>
<p class="mg-muted mg-form-note">This opens your email app with the message filled in.</p>
</form>
</div>
</section>

</main>
