{{!< default}}
<main id="main" class="mg-wrap mg-listing">
{{#author}}<header class="mg-head mg-center"><span class="mg-author-photo">{{#if profile_image}}<img src="{{img_url profile_image size="s"}}" alt="">{{else}}{{> "monogram" size="lg"}}{{/if}}</span><h1 class="mg-h1">{{name}}</h1>{{#if bio}}<p class="mg-lead">{{bio}}</p>{{/if}}</header>{{/author}}
<div class="mg-post-grid">{{#foreach posts}}{{> "post-card"}}{{/foreach}}</div>
{{> "pager"}}
</main>
