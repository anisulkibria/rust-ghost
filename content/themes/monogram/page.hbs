{{!< default}}
{{#post}}
<main id="main" class="mg-article">
{{#match @page.show_title_and_feature_image}}
<header class="mg-wrap mg-article-head"><h1 class="mg-article-title">{{title}}</h1>{{#if custom_excerpt}}<p class="mg-lead">{{custom_excerpt}}</p>{{/if}}</header>
{{#if feature_image}}<figure class="mg-wrap mg-article-img"><div class="mg-card"><img src="{{img_url feature_image size="xl"}}" alt="{{title}}"></div></figure>{{/if}}
{{/match}}
<article class="mg-prose gh-content">{{content}}</article>
</main>
{{/post}}
