<aside class="doc-side" aria-label="{{t "Contents"}}">
    <button class="contents-toggle" type="button" aria-expanded="false" aria-controls="doc-tree" data-contents-toggle>
        {{> "icons/contents"}}<span>{{t "Contents"}}</span>{{> "icons/chevron"}}
    </button>
    <div class="doc-tree" id="doc-tree">
        <p class="nav-heading" aria-hidden="true">{{t "Contents"}}</p>
        {{> "tree"}}
    </div>
</aside>
