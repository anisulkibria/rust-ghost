{{!< default}}

<main class="site-main" id="main">
    <div class="wrap narrow-page">
        {{#author}}
            <header class="author-header">
                {{#if profile_image}}<img class="author-portrait" src="{{img_url profile_image size="s"}}" alt="" width="80" height="80">{{/if}}
                <div>
                    <h1 class="page-title">{{name}}</h1>
                    {{#if bio}}<p class="doc-dek">{{bio}}</p>{{/if}}
                    <p class="page-meta">{{plural ../pagination.total empty=(t "No articles yet") singular=(t "1 article") plural=(t "% articles")}}</p>
                </div>
            </header>
        {{/author}}
        <ol class="article-list" role="list">
            {{#foreach posts}}{{> "article-row"}}{{/foreach}}
        </ol>
        {{pagination}}
    </div>
    <div hidden>{{> "tree"}}</div>
</main>
