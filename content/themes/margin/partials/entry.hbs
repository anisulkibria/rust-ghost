<article class="entry {{post_class}}{{#if full}} is-full{{/if}}">
    {{#if @custom.show_dates_in_margin}}{{> "dateline"}}{{/if}}

    <div class="entry-body">
        <header class="entry-header">
            <h2 class="entry-title"><a href="{{url}}">{{title}}</a></h2>
            {{> "byline"}}
        </header>

        {{#if @custom.show_feature_images_in_list}}
            {{#if feature_image}}
                <a class="entry-image" href="{{url}}" tabindex="-1" aria-hidden="true">
                    <img
                        srcset="{{img_url feature_image size="m"}} 720w, {{img_url feature_image size="l"}} 1080w, {{img_url feature_image size="xl"}} 1600w"
                        sizes="(max-width: 760px) 100vw, 680px"
                        src="{{img_url feature_image size="l"}}"
                        alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                        loading="lazy">
                </a>
            {{/if}}
        {{/if}}

        {{#if full}}
            <div class="content">{{content}}</div>
            {{#if comments}}
                <p class="entry-more"><a href="{{url}}#comments">{{comment_count empty=(t "Leave a comment") singular=(t "comment") plural=(t "comments")}}</a></p>
            {{/if}}
        {{else}}
            {{#if excerpt}}<p class="entry-excerpt">{{excerpt words="48"}}</p>{{/if}}
            <p class="entry-more"><a href="{{url}}">{{t "Continue reading"}}<span class="visually-hidden"> {{title}}</span></a></p>
        {{/if}}
    </div>
</article>
