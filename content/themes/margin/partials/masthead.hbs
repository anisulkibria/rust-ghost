<header class="masthead">
    <div class="masthead-inner wrap">
        <div class="masthead-brand">
            {{#if @site.logo}}
                <a class="masthead-logo" href="{{@site.url}}"><img src="{{img_url @site.logo size="s"}}" alt="{{@site.title}}"></a>
            {{else}}
                <a class="masthead-title" href="{{@site.url}}">{{@site.title}}</a>
            {{/if}}
            {{#if @site.description}}
                <p class="masthead-description">{{@site.description}}</p>
            {{/if}}
        </div>

        <div class="masthead-tools">
            {{> "scheme-toggle"}}
            <button class="icon-button" data-ghost-search aria-label="{{t "Search"}}">{{> "icons/search"}}</button>
            <button class="icon-button menu-toggle" aria-label="{{t "Menu"}}" aria-expanded="false" aria-controls="site-menu">{{> "icons/menu"}}</button>
        </div>
    </div>

    <nav class="site-nav" id="site-menu" aria-label="{{t "Main"}}">
        <div class="site-nav-inner wrap">
            {{navigation}}
            <div class="site-nav-end">
                {{#if @site.members_enabled}}
                    <div class="member-links">
                        {{#if @member}}
                            <a class="button button-quiet" href="#/portal/account" data-portal="account">{{t "Your account"}}</a>
                        {{else}}
                            <a class="text-link" href="#/portal/signin" data-portal="signin">{{t "Sign in"}}</a>
                            {{#unless @site.members_invite_only}}
                                <a class="button" href="#/portal/signup" data-portal="signup">{{t "Subscribe"}}</a>
                            {{/unless}}
                        {{/if}}
                    </div>
                {{/if}}
            </div>
        </div>
    </nav>
</header>
