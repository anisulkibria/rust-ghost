<header class="masthead">
    <div class="masthead-inner wrap">
        <div class="masthead-brand">
            {{#if @site.logo}}
                <a class="masthead-logo" href="{{@site.url}}"><img src="{{img_url @site.logo size="s"}}" alt="{{@site.title}}"></a>
            {{else}}
                <a class="masthead-title" href="{{@site.url}}">{{@site.title}}</a>
            {{/if}}
            {{#if @site.description}}<p class="masthead-description">{{@site.description}}</p>{{/if}}
        </div>

        <nav class="site-nav" id="site-menu" aria-label="{{t "Main"}}">
            {{navigation}}
            {{> "member-links"}}
        </nav>

        <div class="masthead-tools">
            <div class="masthead-icons">
                <button class="icon-button" type="button" data-ghost-search aria-label="{{t "Search"}}">{{> "icons/search"}}</button>
                {{> "scheme-toggle"}}
                <button class="icon-button menu-toggle" type="button" aria-label="{{t "Menu"}}" aria-expanded="false" aria-controls="site-menu">{{> "icons/menu"}}</button>
            </div>
            {{> "member-links"}}
        </div>
    </div>
</header>
