{{!-- Switches between light and dark; the reader's choice is remembered. --}}
<button class="icon-button scheme-toggle" type="button" data-scheme-toggle
    aria-label="{{t "Switch to dark mode"}}"
    data-label-dark="{{t "Switch to dark mode"}}"
    data-label-light="{{t "Switch to light mode"}}">
    <span class="scheme-icon scheme-icon-moon">{{> "icons/moon"}}</span>
    <span class="scheme-icon scheme-icon-sun">{{> "icons/sun"}}</span>
</button>
