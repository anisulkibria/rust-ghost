<form class="subscribe-form" data-members-form="subscribe">
    <label class="visually-hidden" for="{{field_id}}">{{t "Email address"}}</label>
    <input id="{{field_id}}" class="subscribe-input" type="email" name="email" autocomplete="email" placeholder="{{t "you@example.com"}}" required data-members-email>
    <button class="button subscribe-button" type="submit">
        <span class="when-idle">{{t "Subscribe"}}</span>
        <span class="when-loading">{{t "Sending…"}}</span>
        <span class="when-success">{{t "Check your inbox"}}</span>
    </button>
    <p class="subscribe-success">{{t "We sent you a link. Open it to confirm your subscription."}}</p>
    <p class="subscribe-error" data-members-error></p>
</form>
