<footer class="cv-foot">
<div class="cv-wrap">
<div class="cv-foot-social">
{{#if @site.twitter}}<a href="{{twitter_url @site.twitter}}" aria-label="X" rel="noopener">{{> "icon" name="x" size="16"}}</a>{{/if}}
{{#if @site.facebook}}<a href="{{facebook_url @site.facebook}}" aria-label="Facebook" rel="noopener">{{> "icon" name="fb" size="18"}}</a>{{/if}}
</div>
<div class="cv-foot-bar">
<a class="cv-foot-name" href="{{@site.url}}">{{@site.title}}</a>
<nav class="cv-foot-nav" aria-label="Footer">{{#foreach @site.secondary_navigation}}<a href="{{url absolute="true"}}">{{label}}</a>{{/foreach}}</nav>
<p class="cv-foot-power">Powered by <a href="https://vuuut.com" rel="noopener">Vuuut</a></p>
</div>
</div>
</footer>
