<article class="cv-strip-item {{post_class}}">
<div><h3 class="cv-title"><a href="{{url}}">{{title}}</a></h3>{{> "byline"}}</div>
{{#if feature_image}}<a class="cv-thumb" href="{{url}}" tabindex="-1" aria-hidden="true"><img src="{{img_url feature_image size="xs"}}" alt="" loading="lazy"></a>{{/if}}
</article>
