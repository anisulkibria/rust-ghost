{{#match pagination.pages ">" 1}}
<nav class="cv-pager" aria-label="Pages">
{{#if pagination.prev}}<a class="cv-pager-link" href="{{page_url pagination.prev}}">← Newer</a>{{else}}<span></span>{{/if}}
<span class="cv-pager-note">Page {{pagination.page}} of {{pagination.pages}}</span>
{{#if pagination.next}}<a class="cv-pager-link" href="{{page_url pagination.next}}">Older →</a>{{else}}<span></span>{{/if}}
</nav>
{{/match}}
