{{!< default}}
<main id="main" class="cv-main">
{{#author}}<header class="cv-wrap cv-page-head">{{#if profile_image}}<img class="cv-page-pic cv-round" src="{{img_url profile_image size="xs"}}" alt="">{{/if}}<h1 class="cv-page-title">{{name}}</h1>{{#if bio}}<p class="cv-page-desc">{{bio}}</p>{{/if}}<p class="cv-page-links">{{#if location}}<span>{{location}}</span>{{/if}}{{#if website}}<a href="{{website}}" rel="noopener">Website</a>{{/if}}{{#if twitter}}<a href="{{social_url type="twitter"}}" rel="noopener">X</a>{{/if}}</p></header>{{/author}}
<section class="cv-wrap cv-block"><div class="cv-grid">{{#foreach posts}}{{> "story" pic=true showex=true}}{{/foreach}}</div>{{> "pager"}}</section>
</main>
