{{!< default}}
{{#post}}
<main id="main" class="cv-main">
<article class="cv-article {{post_class}}">
<header class="cv-wrap cv-article-head">
{{#if primary_tag}}<a class="cv-kicker" href="{{primary_tag.url}}">{{primary_tag.name}}</a>{{/if}}
<h1 class="cv-article-title">{{title}}</h1>
{{#if custom_excerpt}}<p class="cv-article-excerpt">{{custom_excerpt}}</p>{{/if}}
<div class="cv-article-meta">
{{#foreach authors limit="1"}}{{#if profile_image}}<a href="{{url}}"><img class="cv-avatar" src="{{img_url profile_image size="xs"}}" alt=""></a>{{/if}}{{/foreach}}
<div><span class="cv-article-authors">{{authors separator=", "}}</span><span class="cv-article-date"><time datetime="{{date format="YYYY-MM-DD"}}">{{date format="D MMM YYYY"}}</time> · {{reading_time minute="1 min read" minutes="% min read"}}</span></div>
</div>
</header>
{{#if feature_image}}<figure class="cv-wrap cv-article-img"><img src="{{img_url feature_image size="l"}}" srcset="{{img_url feature_image size="m"}} 720w, {{img_url feature_image size="l"}} 1200w, {{img_url feature_image size="xl"}} 2000w" sizes="(max-width: 1200px) 100vw, 1200px" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}">{{#if feature_image_caption}}<figcaption>{{feature_image_caption}}</figcaption>{{/if}}</figure>{{/if}}
<div class="cv-content gh-content">{{content}}</div>
<footer class="cv-article-foot">
<div class="cv-share">
<a href="https://x.com/intent/tweet?url={{encode (url absolute="true")}}&amp;text={{encode title}}" target="_blank" rel="noopener" aria-label="Share on X">{{> "icon" name="x" size="14"}}</a>
<a href="https://www.facebook.com/sharer/sharer.php?u={{encode (url absolute="true")}}" target="_blank" rel="noopener" aria-label="Share on Facebook">{{> "icon" name="fb" size="16"}}</a>
<button type="button" data-cv-copy="{{url absolute="true"}}" aria-label="Copy link">{{> "icon" name="link" size="15"}}</button>
</div>
{{#if tags}}<p class="cv-tags">{{#foreach tags}}{{#match visibility "public"}}<a href="{{url}}">{{name}}</a>{{/match}}{{/foreach}}</p>{{/if}}
</footer>
<div class="cv-comments">{{comments}}</div>
</article>
{{#get "posts" filter="id:-{{id}}" limit="4" include="tags,authors"}}{{#if posts}}
<section class="cv-wrap cv-block"><h2 class="cv-label">Read next</h2><div class="cv-grid">{{#foreach posts}}{{> "story" pic=true showex=true}}{{/foreach}}</div></section>
{{/if}}{{/get}}
</main>
{{/post}}
