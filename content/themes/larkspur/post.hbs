{{!< default}}
{{#post}}
<main id="main" class="wrap reading">
    <article>
        <header class="reading-head"><p class="eyebrow">{{date format="D MMM YYYY"}}</p><h1>{{title}}</h1>{{#if custom_excerpt}}<p>{{custom_excerpt}}</p>{{/if}}</header>
        {{#if feature_image}}<figure><img src="{{img_url feature_image size="l"}}" alt="{{feature_image_alt}}">{{#if feature_image_caption}}<figcaption>{{feature_image_caption}}</figcaption>{{/if}}</figure>{{/if}}
        <div class="gh-content prose">{{content}}</div>
        {{#if comments}}{{comments}}{{/if}}
    </article>
</main>
{{/post}}
