{{!< default}}
{{#post}}
<main id="main" class="wrap reading{{#is "shop"}} store-default{{/is}}">
    <article>
        {{#if @page.show_title_and_feature_image}}
            <header class="reading-head"><h1>{{title}}</h1>{{#if custom_excerpt}}<p>{{custom_excerpt}}</p>{{/if}}</header>
            {{#if feature_image}}<figure><img src="{{img_url feature_image size="l"}}" alt="{{feature_image_alt}}">{{#if feature_image_caption}}<figcaption>{{feature_image_caption}}</figcaption>{{/if}}</figure>{{/if}}
        {{/if}}
        <div class="gh-content prose">{{content}}</div>
    </article>
</main>
{{/post}}
