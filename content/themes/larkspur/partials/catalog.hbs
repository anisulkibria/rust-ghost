<header class="catalog-head{{#if collection.feature_image}} has-art{{/if}}">
    <div class="catalog-heading">
        {{#if collection}}<nav class="crumbs" aria-label="Breadcrumb"><a href="{{shop.url}}">Shop</a><span aria-hidden="true">/</span><a href="{{shop.collections_url}}">Collections</a></nav>{{/if}}
        <h1>{{#if query}}Results for “{{query}}”{{else if collection}}{{collection.title}}{{else}}{{#if heading}}{{heading}}{{else}}Shop all{{/if}}{{/if}}</h1>
        {{#unless query}}
            {{#if collection.description}}<p>{{collection.description}}</p>{{else}}{{#if intro}}<p>{{intro}}</p>{{/if}}{{/if}}
        {{/unless}}
    </div>
    {{#if collection.feature_image}}<img src="{{collection.feature_image}}" alt="" fetchpriority="high">{{/if}}
</header>
<div class="catalog-tools">
    <nav class="filter-links" aria-label="Collections">
        <a href="{{shop.url}}"{{#unless collection}} aria-current="page"{{/unless}}>All</a>
        {{#foreach collections}}<a href="{{url}}"{{#if current}} aria-current="page"{{/if}}>{{title}}</a>{{/foreach}}
    </nav>
    <form class="filters" method="get" id="shop-search" action="{{#if collection}}{{collection.url}}{{else}}{{shop.url}}{{/if}}" role="search">
        <label class="search-field">{{> "icon" name="search"}}<span class="visually-hidden">Search products</span><input name="q" type="search" value="{{query}}" placeholder="Search products" maxlength="100"></label>
        <label class="sort-field"><span class="visually-hidden">Sort by</span><select name="sort">{{#foreach sorts}}<option value="{{value}}"{{#if selected}} selected{{/if}}>{{label}}</option>{{/foreach}}</select></label>
        <button class="button" type="submit">Apply</button>
    </form>
</div>
<p class="results-count">{{plural total empty="No products" singular="% product" plural="% products"}}</p>
{{#if products}}
    <div class="product-grid">{{#foreach products}}{{> "product-card"}}{{/foreach}}</div>
    {{#match pagination.pages ">" 1}}
        <nav class="pagination" aria-label="Pages">
            {{#if pagination.prev_url}}<a href="{{pagination.prev_url}}" rel="prev">Previous</a>{{/if}}
            <span>Page {{pagination.page}} of {{pagination.pages}}</span>
            {{#if pagination.next_url}}<a href="{{pagination.next_url}}" rel="next">Next</a>{{/if}}
        </nav>
    {{/match}}
{{else}}
    <div class="empty"><h2>{{#if query}}No products match that search.{{else}}There are no products here yet.{{/if}}</h2><a class="button" href="{{shop.url}}">Browse the shop</a></div>
{{/if}}
