{{!< default}}
{{#post}}
<main id="main" class="ms-main">
<article class="ms-article">
{{#match @page.show_title_and_feature_image}}
<header class="ms-wrap ms-article-head"><h1 class="ms-article-title">{{title}}</h1>{{#if custom_excerpt}}<p class="ms-article-excerpt">{{custom_excerpt}}</p>{{/if}}</header>
{{#if feature_image}}<figure class="ms-wrap ms-article-img"><img src="{{img_url feature_image size="l"}}" alt="{{title}}"></figure>{{/if}}
{{/match}}
<div class="ms-content gh-content">{{content}}</div>
</article>
</main>
{{/post}}
