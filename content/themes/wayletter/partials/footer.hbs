<footer class="ms-foot">
<div class="ms-wrap ms-foot-in">
<p class="ms-foot-copy">{{@site.title}} © {{date format="YYYY"}}</p>
<div class="ms-foot-mid">
<div class="ms-foot-social">
{{#if @site.twitter}}<a href="{{twitter_url @site.twitter}}" aria-label="X" rel="noopener">{{> "icon" name="x" size="16"}}</a>{{/if}}
{{#if @site.facebook}}<a href="{{facebook_url @site.facebook}}" aria-label="Facebook" rel="noopener">{{> "icon" name="fb" size="17"}}</a>{{/if}}
</div>
{{#if @site.secondary_navigation}}<nav class="ms-foot-nav" aria-label="Footer">{{#foreach @site.secondary_navigation}}<a href="{{url absolute="true"}}">{{label}}</a>{{/foreach}}</nav>{{/if}}
</div>
<p class="ms-foot-power">Powered by <a href="https://vuuut.com" rel="noopener">Vuuut</a></p>
</div>
</footer>
