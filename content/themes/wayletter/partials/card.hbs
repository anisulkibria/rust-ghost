<article class="ms-card {{post_class}}">
<a class="ms-card-img" href="{{url}}" tabindex="-1" aria-hidden="true">{{#if feature_image}}<img src="{{img_url feature_image size="m"}}" srcset="{{img_url feature_image size="s"}} 400w, {{img_url feature_image size="m"}} 750w" sizes="(max-width: 767px) 100vw, 33vw" alt="" loading="lazy">{{else}}<span class="ms-card-blank">{{title}}</span>{{/if}}</a>
<p class="ms-card-meta">{{#if primary_tag}}<span>{{primary_tag.name}}</span>{{/if}}<time datetime="{{date format="YYYY-MM-DD"}}">{{date format="D MMM YYYY"}}</time></p>
<h3 class="ms-card-title"><a href="{{url}}">{{title}}</a></h3>
</article>
