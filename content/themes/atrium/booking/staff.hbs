{{!< default}}
{{> "booking-assets"}}
{{#person}}
<main id="main" class="bk-page">
    <div class="wrap"><nav class="crumbs"><a href="{{../booking.url}}">{{../booking.title}}</a><span>/</span><span>Team</span></nav></div>
    <section class="wrap profile">
        <div class="profile-art">{{#if photo}}<img src="{{photo}}" alt="">{{else}}<i>{{initials}}</i>{{/if}}</div>
        <div class="profile-copy">
            <p class="eyebrow">{{title}}</p><h1>{{name}}</h1>
            {{#if bio}}<p class="lede">{{bio}}</p>{{/if}}
            {{#if hours}}<div class="aside-card"><h3>Usually available</h3><dl class="hours">{{#foreach hours}}<dt>{{short}}</dt><dd>{{hours}}</dd>{{/foreach}}</dl></div>{{/if}}
        </div>
    </section>
    <section class="wrap band"><header class="band-head"><div><p class="eyebrow">Book with {{name}}</p><h2>Services</h2></div></header>
        <div class="svc-grid">{{#foreach ../services}}{{> "service-card"}}{{/foreach}}</div></section>
</main>
{{/person}}
