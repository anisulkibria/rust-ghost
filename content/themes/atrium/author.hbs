{{!< default}}
<main id="main" class="list-page">
    {{#author}}<header class="page-head wrap">{{#if profile_image}}<img class="author-img" src="{{img_url profile_image size="s"}}" alt="">{{/if}}<p class="eyebrow">Writer</p><h1>{{name}}</h1>{{#if bio}}<p class="lede">{{bio}}</p>{{/if}}</header>{{/author}}
    <div class="wrap post-grid">{{#foreach posts}}{{> "post-card"}}{{/foreach}}</div>
    {{> "pagination"}}
</main>
