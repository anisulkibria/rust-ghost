{{!< default}}
<main id="main" class="list-page">
    <header class="page-head wrap"><p class="eyebrow">Journal</p><h1>{{@site.title}}</h1>{{#if @site.description}}<p class="lede">{{@site.description}}</p>{{/if}}</header>
    <div class="wrap post-grid">{{#foreach posts}}{{> "post-card"}}{{/foreach}}</div>
    {{> "pagination"}}
</main>
