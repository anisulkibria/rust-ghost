{{!< default}}

<main class="site-main" id="main">
    <section class="cover error-cover wrap">
        <div class="cover-band cover-top">
            <span class="cover-section">{{t "Error"}} {{statusCode}}</span>
        </div>
        <div class="cover-panel">
            <div class="cover-text">
                <h1 class="cover-title">{{#if message}}{{message}}{{else}}{{t "Something went wrong"}}{{/if}}</h1>
                <p class="cover-dek">{{t "Reload the page in a moment. If it keeps happening, go back to the front page."}}</p>
                <p class="error-actions"><a class="button" href="{{@site.url}}">{{t "Go to the front page"}}</a></p>
            </div>
        </div>
        <div class="cover-band cover-bottom"><span>{{@site.title}}</span></div>
    </section>

    {{#if errorDetails}}
        <section class="error-details wrap-text">
            <h2>{{t "Theme errors"}}</h2>
            <ul>
                {{#foreach errorDetails}}
                    <li><strong>{{{rule}}}</strong>{{#foreach failures}}<br>{{ref}}: {{message}}{{/foreach}}</li>
                {{/foreach}}
            </ul>
        </section>
    {{/if}}
</main>
