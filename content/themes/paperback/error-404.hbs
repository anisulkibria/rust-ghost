{{!< default}}

<main class="site-main" id="main">
    <section class="cover error-cover wrap">
        <div class="cover-band cover-top">
            <span class="cover-section">{{t "Error"}} {{statusCode}}</span>
        </div>
        <div class="cover-panel">
            <div class="cover-text">
                <h1 class="cover-title">{{t "This page isn't here"}}</h1>
                <p class="cover-dek">{{t "The link may be old, or the post may have moved. Search the site or start again from the front page."}}</p>
                <p class="error-actions">
                    <a class="button" href="{{@site.url}}">{{t "Go to the front page"}}</a>
                    <button class="button button-quiet" type="button" data-ghost-search>{{t "Search"}}</button>
                </p>
            </div>
        </div>
        <div class="cover-band cover-bottom"><span>{{@site.title}}</span></div>
    </section>

    {{#get "posts" limit="3" include="tags,authors" as |recent|}}
        {{#if recent}}
            <section class="related" aria-labelledby="recent-heading">
                <h2 class="shelf-heading wrap" id="recent-heading">{{t "Latest"}}</h2>
                <div class="shelf shelf-three wrap">
                    {{#foreach recent}}{{> "card"}}{{/foreach}}
                </div>
            </section>
        {{/if}}
    {{/get}}
</main>
