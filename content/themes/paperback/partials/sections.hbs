{{#get "tags" limit="3" include="count.posts" order="count.posts desc" filter="visibility:public" as |sections|}}
    {{#foreach sections}}
        {{#if count.posts}}
            <section class="section-shelf" style="{{> "band" color=accent_color}}" aria-labelledby="section-{{slug}}">
                <header class="section-head">
                    <div class="section-head-inner wrap">
                        <h2 class="section-title" id="section-{{slug}}"><a href="{{url}}">{{name}}</a></h2>
                        {{#if description}}<p class="section-description">{{description}}</p>{{/if}}
                        <a class="section-all" href="{{url}}">{{plural count.posts empty=(t "No posts") singular=(t "1 post") plural=(t "All % posts")}}</a>
                    </div>
                </header>
                {{#get "posts" filter="tags:{{slug}}" limit="4" include="authors" as |picks|}}
                    <ul class="section-list wrap">
                        {{#foreach picks}}
                            <li class="section-item">
                                <h3 class="section-item-title"><a href="{{url}}">{{title}}</a></h3>
                                <p class="section-item-meta">{{#if authors}}{{authors separator=" & " autolink="false"}}, {{/if}}<time datetime="{{date format="YYYY-MM-DD"}}">{{date format="D MMM YYYY"}}</time></p>
                            </li>
                        {{/foreach}}
                    </ul>
                {{/get}}
            </section>
        {{/if}}
    {{/foreach}}
{{/get}}
