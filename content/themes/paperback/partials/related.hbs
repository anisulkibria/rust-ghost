{{#if primary_tag}}
    {{#get "posts" filter="tags:{{primary_tag.slug}}+id:-{{id}}" limit="3" include="tags,authors" as |related|}}
        {{#if related}}
            <section class="related" aria-labelledby="related-heading">
                <h2 class="shelf-heading wrap" id="related-heading">{{t "More in"}} <a href="{{../primary_tag.url}}">{{../primary_tag.name}}</a></h2>
                <div class="shelf shelf-three wrap">
                    {{#foreach related}}{{> "card"}}{{/foreach}}
                </div>
            </section>
        {{/if}}
    {{/get}}
{{else}}
    {{#get "posts" filter="id:-{{id}}" limit="3" include="tags,authors" as |related|}}
        {{#if related}}
            <section class="related" aria-labelledby="related-heading">
                <h2 class="shelf-heading wrap" id="related-heading">{{t "Keep reading"}}</h2>
                <div class="shelf shelf-three wrap">
                    {{#foreach related}}{{> "card"}}{{/foreach}}
                </div>
            </section>
        {{/if}}
    {{/get}}
{{/if}}
