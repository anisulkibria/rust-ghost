<footer class="article-footer wrap-text">
    {{#if tags}}
        <div class="article-tags">
            <h2 class="visually-hidden">{{t "Tags"}}</h2>
            <ul>
                {{#foreach tags}}
                    <li style="{{> "band" color=accent_color}}"><a href="{{url}}">{{name}}</a></li>
                {{/foreach}}
            </ul>
        </div>
    {{/if}}

    <div class="article-share">
        <button class="share-button" type="button" data-copy-url="{{url absolute="true"}}">
            {{> "icons/link"}}
            <span class="when-idle">{{t "Copy link"}}</span>
            <span class="when-done">{{t "Link copied"}}</span>
        </button>
    </div>

    {{#if @custom.show_author_card}}
        {{#foreach authors}}
            <section class="author-card">
                {{#if profile_image}}
                    <a class="author-card-image" href="{{url}}"><img src="{{img_url profile_image size="xs"}}" alt="" width="72" height="72" loading="lazy"></a>
                {{/if}}
                <div class="author-card-text">
                    <h2 class="author-card-name"><a href="{{url}}">{{name}}</a></h2>
                    {{#if bio}}<p>{{bio}}</p>{{/if}}
                    <a class="author-card-more" href="{{url}}">{{t "More by"}} {{name}}</a>
                </div>
            </section>
        {{/foreach}}
    {{/if}}
</footer>
