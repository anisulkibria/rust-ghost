<article class="card {{post_class}}" style="{{> "band" color=primary_tag.accent_color}}">
    <div class="card-band">
        {{#if primary_tag}}<a class="card-section" href="{{primary_tag.url}}">{{primary_tag.name}}</a>{{/if}}
        {{#match visibility "!=" "public"}}<span class="card-access" title="{{#match visibility "paid"}}{{t "For paid subscribers"}}{{else}}{{t "For members"}}{{/match}}">{{> "icons/lock"}}<span class="visually-hidden">{{#match visibility "paid"}}{{t "For paid subscribers"}}{{else}}{{t "For members"}}{{/match}}</span></span>{{/match}}
    </div>

    <div class="card-body">
        {{#if @custom.show_images_on_cards}}
            {{#if feature_image}}
                <a class="card-image" href="{{url}}" tabindex="-1" aria-hidden="true">
                    <img
                        srcset="{{img_url feature_image size="s"}} 400w, {{img_url feature_image size="m"}} 760w"
                        sizes="(max-width: 700px) 100vw, 400px"
                        src="{{img_url feature_image size="m"}}"
                        alt=""
                        loading="lazy">
                </a>
            {{/if}}
        {{/if}}

        <h3 class="card-title"><a href="{{url}}">{{title}}</a></h3>
        {{#if excerpt}}<p class="card-excerpt">{{excerpt words="28"}}</p>{{/if}}
        <p class="card-meta">
            {{#if authors}}<span class="card-authors">{{authors separator=" & " autolink="false"}}</span>{{/if}}
            <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="D MMMM YYYY"}}</time>
        </p>
    </div>
</article>
