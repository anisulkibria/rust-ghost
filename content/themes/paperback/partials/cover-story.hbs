<article class="cover cover-story wrap {{post_class}}" style="{{> "band" color=primary_tag.accent_color}}">
    <div class="cover-band cover-top">
        {{#if primary_tag}}<a class="cover-section" href="{{primary_tag.url}}">{{primary_tag.name}}</a>{{else}}<span class="cover-section">{{t "Latest"}}</span>{{/if}}
        <time class="cover-date" datetime="{{date format="YYYY-MM-DD"}}">{{date format="D MMMM YYYY"}}</time>
    </div>

    <div class="cover-panel{{#if feature_image}} has-plate{{/if}}">
        {{#if feature_image}}
            <a class="cover-plate" href="{{url}}" tabindex="-1" aria-hidden="true">
                <img
                    srcset="{{img_url feature_image size="m"}} 760w, {{img_url feature_image size="l"}} 1200w"
                    sizes="(max-width: 900px) 100vw, 560px"
                    src="{{img_url feature_image size="l"}}"
                    alt="">
            </a>
        {{/if}}
        <div class="cover-text">
            <h2 class="cover-title"><a href="{{url}}">{{title}}</a></h2>
            {{#if excerpt}}<p class="cover-dek">{{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{excerpt words="36"}}{{/if}}</p>{{/if}}
            {{#if authors}}<p class="cover-byline"><span>{{t "By"}} {{authors separator=" & "}}</span></p>{{/if}}
        </div>
    </div>

    <div class="cover-band cover-bottom">
        <span>{{@site.title}}</span>
        {{#if reading_time}}<span>{{reading_time minute=(t "1 min read") minutes=(t "% min read")}}</span>{{/if}}
    </div>
</article>
