{{!< default}}
{{!-- Post template "Image cover": the feature image moves inside the cover, beside the title. --}}

{{#post}}
<main class="site-main" id="main">
    <article class="article {{post_class}}" style="{{> "band" color=primary_tag.accent_color}}">
        {{> "article-cover" image_cover=true}}

        {{#if feature_image_caption}}
            <p class="article-image-caption wrap">{{feature_image_caption}}</p>
        {{/if}}

        <div class="content gh-content">
            {{content}}
        </div>

        {{> "article-footer"}}
    </article>

    {{#if comments}}
        <section class="comments wrap-text" id="comments" aria-label="{{t "Comments"}}">
            {{comments}}
        </section>
    {{/if}}

    {{#if @custom.show_related_posts}}{{> "related"}}{{/if}}
</main>
{{/post}}
