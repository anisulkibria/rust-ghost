{{!< default}}

{{#post}}
<main class="site-main" id="main">
    <article class="article {{post_class}}" style="{{> "band" color=primary_tag.accent_color}}">
        {{> "article-cover"}}

        {{#if feature_image}}
            <figure class="article-image wrap">
                <img
                    srcset="{{img_url feature_image size="m"}} 760w, {{img_url feature_image size="l"}} 1200w, {{img_url feature_image size="xl"}} 1800w"
                    sizes="(max-width: 1240px) 100vw, 1200px"
                    src="{{img_url feature_image size="xl"}}"
                    alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}">
                {{#if feature_image_caption}}<figcaption>{{feature_image_caption}}</figcaption>{{/if}}
            </figure>
        {{/if}}

        <div class="content gh-content">
            {{content}}
        </div>

        {{> "article-footer"}}
    </article>

    {{#if comments}}
        <section class="comments wrap-text" id="comments" aria-label="{{t "Comments"}}">
            {{comments}}
        </section>
    {{/if}}

    {{#if @custom.show_related_posts}}{{> "related"}}{{/if}}
</main>
{{/post}}
