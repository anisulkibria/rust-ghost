<!DOCTYPE html>
<html lang="{{@site.locale}}" data-scheme="{{#match @custom.color_scheme "Light"}}light{{else match @custom.color_scheme "Dark"}}dark{{else}}auto{{/match}}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {{!-- A reader's own light/dark choice, applied before anything paints. --}}
    <script>try{var s=localStorage.getItem('vuuut-scheme');if(s==='light'||s==='dark')document.documentElement.setAttribute('data-scheme',s)}catch(e){}</script>
    <title>{{meta_title page=(t " (Page %)")}}</title>

    <link rel="preload" as="font" type="font/woff2" href="{{asset "fonts/jost-roman.woff2"}}" crossorigin>
    <link rel="preload" as="font" type="font/woff2" href="{{asset "fonts/newsreader-roman.woff2"}}" crossorigin>
    <style>
        @font-face { font-family: "Jost"; font-style: normal; font-weight: 300 800; font-display: swap; src: url("{{asset "fonts/jost-roman.woff2"}}") format("woff2"); }
        @font-face { font-family: "Jost"; font-style: italic; font-weight: 300 800; font-display: swap; src: url("{{asset "fonts/jost-italic.woff2"}}") format("woff2"); }
        @font-face { font-family: "Newsreader"; font-style: normal; font-weight: 300 700; font-display: swap; src: url("{{asset "fonts/newsreader-roman.woff2"}}") format("woff2"); }
        @font-face { font-family: "Newsreader"; font-style: italic; font-weight: 300 700; font-display: swap; src: url("{{asset "fonts/newsreader-italic.woff2"}}") format("woff2"); }
    </style>
    <link rel="stylesheet" href="{{asset "css/screen.css"}}">
    {{#if @site.accent_color}}<style>:root { --site-band: {{@site.accent_color}}; --site-band-ink: {{contrast_text_color @site.accent_color}}; }</style>{{/if}}

    {{ghost_head}}
</head>
<body class="{{body_class}} title-{{#match @custom.title_font "Serif"}}serif{{else}}sans{{/match}} text-{{#match @custom.body_font "Sans-serif"}}sans{{else}}serif{{/match}}">

<a class="skip-link" href="#main">{{t "Skip to content"}}</a>

<div class="site">
    {{> "header"}}

    {{{body}}}

    {{> "footer"}}
</div>

<script src="{{asset "js/paperback.js"}}" defer></script>
{{ghost_foot}}
</body>
</html>
